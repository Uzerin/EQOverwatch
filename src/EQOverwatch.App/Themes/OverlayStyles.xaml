<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:overlays="clr-namespace:EQOverwatch.App.Overlays">

    <!-- Palette -->
    <SolidColorBrush x:Key="UnlockedBackdropBrush" Color="#AA181820"/>
    <SolidColorBrush x:Key="LockedBackdropBrush" Color="#01000000"/>
    <SolidColorBrush x:Key="RowBackdropBrush" Color="#66000000"/>
    <SolidColorBrush x:Key="TitleStripBrush" Color="#CC2A2A44"/>
    <SolidColorBrush x:Key="DashedBorderBrush" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="OverlayTextBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="OverlayMutedTextBrush" Color="#FFB8BCC8"/>
    <SolidColorBrush x:Key="AlertTextBrush" Color="#FFFFD54A"/>
    <SolidColorBrush x:Key="BarBackBrush" Color="#88000000"/>
    <SolidColorBrush x:Key="BarFillBrush" Color="#FF3FA9F5"/>
    <SolidColorBrush x:Key="BarUrgentFillBrush" Color="#FFE0483E"/>
    <SolidColorBrush x:Key="DpsFillBrush" Color="#CC4C8F3A"/>

    <DropShadowEffect x:Key="TextShadowEffect" Color="Black" ShadowDepth="1" BlurRadius="3" Opacity="1"/>

    <!-- Backdrop: dark and visible while unlocked, near-transparent while locked. -->
    <Style x:Key="OverlayBackdropStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource UnlockedBackdropBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLocked, RelativeSource={RelativeSource AncestorType={x:Type overlays:OverlayWindowBase}}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource LockedBackdropBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Dashed outline: unlocked only. -->
    <Style x:Key="OverlayDashedBorderStyle" TargetType="Rectangle">
        <Setter Property="Stroke" Value="{DynamicResource DashedBorderBrush}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeDashArray" Value="4 3"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Margin" Value="1"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLocked, RelativeSource={RelativeSource AncestorType={x:Type overlays:OverlayWindowBase}}}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Drag-move strip with the overlay's name: unlocked only (collapsing it also frees its row). -->
    <Style x:Key="OverlayTitleStripStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource TitleStripBrush}"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="CornerRadius" Value="3,3,0,0"/>
        <Setter Property="Cursor" Value="SizeAll"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLocked, RelativeSource={RelativeSource AncestorType={x:Type overlays:OverlayWindowBase}}}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OverlayTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource OverlayTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Effect" Value="{StaticResource TextShadowEffect}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="OverlayMutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OverlayTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource OverlayMutedTextBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <!-- Small text button in an overlay's title strip (only reachable while the overlay is unlocked). -->
    <Style x:Key="OverlayChipButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource OverlayTextBrush}"/>
        <Setter Property="Background" Value="#33FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Margin" Value="3,2,0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#66FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flash banner text: large, high contrast, drop shadow. -->
    <Style x:Key="AlertTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OverlayTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource AlertTextBrush}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Countdown fill: the theme color of the bar's category (Buffs / Debuffs / Songs / Raid Triggers / CH Chain);
         it turns red in the last seconds (TimerBarViewModel.IsUrgent). -->
    <Style x:Key="TimerFillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BarFillBrush}"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Category}" Value="Buffs">
                <Setter Property="Background" Value="{DynamicResource BuffsBarBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="Debuffs">
                <Setter Property="Background" Value="{DynamicResource DebuffsBarBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="Songs">
                <Setter Property="Background" Value="{DynamicResource SongsBarBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="RaidTriggers">
                <Setter Property="Background" Value="{DynamicResource RaidTriggersBarBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="ChChain">
                <Setter Property="Background" Value="{DynamicResource ChChainBarBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                <Setter Property="Opacity" Value="0.55"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
