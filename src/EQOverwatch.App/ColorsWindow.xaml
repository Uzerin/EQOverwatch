<Window x:Class="EQOverwatch.App.ColorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:EQOverwatch.App.Controls"
        Title="Discord picture colors"
        Icon="pack://application:,,,/Assets/EQOverwatch.ico"
        Width="1100" Height="760"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8"
                       Text="Each player's damage bar in the Discord picture is split by attack type. Click a swatch to pick its color from a color wheel (or type #RRGGBB); the second swatch is the lighter shade crits of that attack get. Pet damage is one color whatever the pet does, and healing is shown in its own color with a lighter shade for critical heals."/>
            <ItemsControl ItemsSource="{Binding AttackColors}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,6">
                            <ctl:ColorSwatchPicker Width="22" Height="22" Margin="0,0,3,0" Hex="{Binding HexText, Mode=TwoWay}"/>
                            <Border Width="22" Height="22" CornerRadius="6" BorderThickness="1" Margin="0,0,8,0"
                                    Background="{Binding CritHex}" BorderBrush="{DynamicResource BorderSoftBrush}"/>
                            <TextBlock Text="{Binding Label}" Width="104" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBox Width="86" FontFamily="Consolas" Text="{Binding HexText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                <Setter Property="BorderBrush" Value="{DynamicResource DebuffsBarBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
                        <Button Content="Reset colors" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,4,0,8"
                    Padding="10,4" Command="{Binding ResetAttackColorsCommand}"/>
            <TextBlock Text="Preview (sample fight)" FontWeight="SemiBold" Margin="0,0,0,4"/>
        </StackPanel>
        <Border BorderThickness="1" BorderBrush="{DynamicResource BorderSoftBrush}" CornerRadius="6" Padding="4">
            <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>
    </DockPanel>
</Window>
