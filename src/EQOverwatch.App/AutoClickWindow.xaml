<Window x:Class="EQOverwatch.App.AutoClickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CH Chain: Advanced"
        Icon="pack://application:,,,/Assets/EQOverwatch.ico"
        Width="780" MinWidth="640" SizeToContent="Height"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="KeyBox" TargetType="Border">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" Text="Auto-press on my CH turn"/>
        <CheckBox Content="Auto-press on my CH turn" Margin="0,0,0,12" IsChecked="{Binding AutoClickEnabled}"
                  ToolTip="Presses your CH key on your turn, only while EverQuest is the window in front. It stays on or off as you leave it."/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Toggle hotkey"
                       ToolTip="Works from any program. Use Ctrl, Alt or Shift plus a key, such as Ctrl+Alt+F9."/>
            <TextBox Grid.Row="0" Grid.Column="1" Width="140" HorizontalAlignment="Left" Margin="0,0,0,8"
                     Text="{Binding AutoClickHotkey, UpdateSourceTrigger=LostFocus}"/>

            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="When"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton GroupName="AutoClickWhen" Content="Chat cue" VerticalAlignment="Center" Margin="0,0,18,0" IsChecked="{Binding AutoClickOnChat}"
                             ToolTip="When another cleric says your position tag with the cue, for example &quot;6-6-6 CAST NOW&quot;."/>
                <RadioButton GroupName="AutoClickWhen" Content="Every" VerticalAlignment="Center" Margin="0,0,6,0" IsChecked="{Binding AutoClickTimed}"
                             ToolTip="A fixed time after your own last Complete Heal. It waits for your first cast by hand after it is switched on. Chat cues then only show on the CH Chain overlay."/>
                <TextBox Width="72" VerticalAlignment="Center" Text="{Binding AutoClickIntervalText, UpdateSourceTrigger=LostFocus}"
                         ToolTip="10.0 to 60.0 seconds, in tenths."/>
                <TextBlock VerticalAlignment="Center" Margin="6,0,0,0" Text="seconds"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="CH key"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                <Border Style="{StaticResource KeyBox}">
                    <TextBlock FontWeight="SemiBold" Text="{Binding AutoClickKeyText}"/>
                </Border>
                <Button Content="Set Key…" Style="{StaticResource SecondaryButton}" Command="{Binding SetAutoClickKeyCommand}"
                        ToolTip="Then press the key (with Shift, Ctrl or Alt if you like). Esc cancels."/>
                <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="12,0,0,0" Text="your Complete Heal hotbar key"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,10,0" Text="Assist key"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Use" VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="{Binding AutoClickUseAssist}"/>
                    <Border Style="{StaticResource KeyBox}">
                        <TextBlock FontWeight="SemiBold" Text="{Binding AutoClickAssistKeyText}"/>
                    </Border>
                    <Button Content="Set Key…" Style="{StaticResource SecondaryButton}" Command="{Binding SetAutoClickAssistKeyCommand}"
                            ToolTip="Then press the key (with Shift, Ctrl or Alt if you like). Esc cancels."/>
                </StackPanel>
                <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0" Text="Pressed 1.0 s and again 0.5 s before the CH key."/>
            </StackPanel>
        </Grid>
        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,4" Text="{Binding AutoClickIntervalError}"/>

        <Border Margin="0,4,0,10" Padding="10,8" CornerRadius="4" Background="{DynamicResource CardBgBrush}">
            <StackPanel>
                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6" Text="Each turn"/>
                <Grid Height="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.ColumnSpan="3" Height="2" VerticalAlignment="Top" Margin="0,8,0,0" Fill="{DynamicResource BorderSoftBrush}"/>
                    <StackPanel Grid.Column="0">
                        <Ellipse Width="14" Height="14" Fill="#4C9AFF" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                        <TextBlock Margin="0,4,0,0"><Run Text="−1.0 s  Assist ("/><Run Text="{Binding AutoClickAssistKeyText, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Ellipse Width="14" Height="14" Fill="#4C9AFF" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                        <TextBlock Margin="0,4,0,0"><Run Text="−0.5 s  Assist ("/><Run Text="{Binding AutoClickAssistKeyText, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Ellipse Width="14" Height="14" Fill="#2EC27E" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                        <TextBlock Margin="0,4,0,0" FontWeight="SemiBold"><Run Text="0 s  CH key ("/><Run Text="{Binding AutoClickKeyText, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Padding="8,6" CornerRadius="4" Margin="0,0,0,8" Background="{DynamicResource RowBackdropBrush}">
            <TextBlock TextWrapping="Wrap" Text="{Binding AutoClickStatus}"/>
        </Border>
        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6" Text="{Binding AutoClickHotkeyNote}"/>
        <TextBlock Style="{StaticResource HintText}"
                   Text="Chat cue: presses when another cleric says your position tag with the cue; the assist presses come from the chain's pace (on the first turn of a fight there is no pace yet, so the assist goes at the cue and the CH key 1.0 s later). Every N seconds: waits for your first Complete Heal by hand, then presses N seconds after your last one; chat then only shows bars and the late-cast alarm. Keys go to the EverQuest window in front; the mouse is never touched. A red outline shows round the CH Chain overlay (or Raid Triggers when CH Chain is off) while it is on. Check your server's rules on automation before using it."/>
    </StackPanel>
</Window>
