<Window x:Class="EQOverwatch.App.AutoClickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CH Chain: Advanced"
        Icon="pack://application:,,,/Assets/EQOverwatch.ico"
        Width="780" MinWidth="620" SizeToContent="Height"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" Text="Auto-click on my CH turn"/>

        <CheckBox Content="Auto-click on my CH turn" Margin="0,0,0,10" IsChecked="{Binding AutoClickEnabled}"
                  ToolTip="Clicks once when the chain cues your position, only while EverQuest is the window in front. It stays on or off as you leave it."/>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Toggle hotkey"
                       ToolTip="Works from any program. Use Ctrl, Alt or Shift plus a key, such as Ctrl+Alt+F9."/>
            <TextBox Grid.Row="0" Grid.Column="1" Width="140" HorizontalAlignment="Left" Margin="0,0,0,6"
                     Text="{Binding AutoClickHotkey, UpdateSourceTrigger=LostFocus}"/>

            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="When"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <RadioButton GroupName="AutoClickWhen" Content="Chat cue" VerticalAlignment="Center" Margin="0,0,18,0" IsChecked="{Binding AutoClickOnChat}"
                             ToolTip="When another cleric says your position tag with the cue, for example &quot;6-6-6 CAST NOW&quot;."/>
                <RadioButton GroupName="AutoClickWhen" Content="Every" VerticalAlignment="Center" Margin="0,0,6,0" IsChecked="{Binding AutoClickTimed}"
                             ToolTip="A fixed time after your own last Complete Heal. It waits for your first cast by hand after it is switched on. Chat cues then only show on the CH Chain overlay."/>
                <TextBox Width="72" VerticalAlignment="Center" Text="{Binding AutoClickIntervalText, UpdateSourceTrigger=LostFocus}"
                         ToolTip="10.0 to 60.0 seconds, in tenths."/>
                <TextBlock VerticalAlignment="Center" Margin="6,0,0,0" Text="seconds"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Action"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <RadioButton GroupName="AutoClickAction" Content="Mouse click" VerticalAlignment="Center" Margin="0,0,18,0" IsChecked="{Binding AutoClickMouse}"/>
                <RadioButton GroupName="AutoClickAction" Content="Press key" VerticalAlignment="Center" IsChecked="{Binding AutoClickPressKey}"
                             ToolTip="Presses a key in the EverQuest window in front instead of clicking; the mouse is not touched."/>
            </StackPanel>

            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Click delay (milliseconds)"
                       ToolTip="How long after the chat cue the press is made. 0 to 5000."/>
            <TextBox Grid.Row="3" Grid.Column="1" Width="70" HorizontalAlignment="Left" Margin="0,0,0,6"
                     Text="{Binding AutoClickDelayMilliseconds, UpdateSourceTrigger=LostFocus}"/>

            <TextBlock Grid.Row="4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                        <Setter Property="Text" Value="Click spot"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AutoClickPressKey}" Value="True">
                                <Setter Property="Text" Value="Key"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Grid Grid.Row="4" Grid.Column="1" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AutoClickPressKey}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding AutoClickSpotText}"/>
                    <Button Content="Set Position…" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding SetAutoClickSpotCommand}"
                            ToolTip="Brings EverQuest forward: click your Complete Heal button there (the click is kept from the game). Esc cancels."/>
                    <Button Content="Use mouse pointer" Style="{StaticResource SecondaryButton}" Command="{Binding UseMousePointerCommand}"
                            ToolTip="Forget the spot and click wherever the mouse pointer is."/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AutoClickPressKey}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Padding="10,3" Margin="0,0,12,0" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderSoftBrush}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AutoClickKeyText}"/>
                    </Border>
                    <Button Content="Set Key…" Style="{StaticResource SecondaryButton}" Command="{Binding SetAutoClickKeyCommand}"
                            ToolTip="Then press the key (with Shift, Ctrl or Alt if you like). Esc cancels."/>
                </StackPanel>
            </Grid>
        </Grid>
        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,4" Text="{Binding AutoClickIntervalError}"/>

        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6" Text="{Binding AutoClickSpotNote}"/>
        <Border Padding="8,6" CornerRadius="4" Margin="0,0,0,8" Background="{DynamicResource RowBackdropBrush}">
            <TextBlock TextWrapping="Wrap" Text="{Binding AutoClickStatus}"/>
        </Border>
        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6" Text="{Binding AutoClickHotkeyNote}"/>
        <TextBlock Style="{StaticResource HintText}"
                   Text="Chat cue: when another cleric says your position tag with the cue, it presses once, after the delay. Every N seconds: it waits for your first Complete Heal by hand, then presses N seconds after your last one; chat cues then only show bars and the late-cast alarm on the overlay. With a click spot the pointer is put on it and held there for the click (half a second early when the turn can be predicted), then let go and put back when your Complete Heal starts. Press key sends the key to the EverQuest window in front and leaves the mouse alone. It does nothing inside the game client and never presses unless EverQuest is the window in front. While it is on, a red outline shows round the CH Chain overlay (or Raid Triggers when CH Chain is off). Check your server's rules on automation before using it."/>
    </StackPanel>
</Window>
