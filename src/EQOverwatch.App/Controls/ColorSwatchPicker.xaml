<UserControl x:Class="EQOverwatch.App.Controls.ColorSwatchPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border x:Name="Swatch" CornerRadius="6" BorderThickness="1" Cursor="Hand"
                BorderBrush="{DynamicResource BorderSoftBrush}" Background="Gray"
                ToolTip="Click to pick a color"
                MouseLeftButtonUp="OnSwatchClick"/>
        <Popup x:Name="Pop" PlacementTarget="{Binding ElementName=Swatch}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade">
            <Border Margin="6" Padding="10" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSoftBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel Width="180">
                    <Grid Width="180" Height="180" Background="Transparent" Cursor="Cross"
                          MouseLeftButtonDown="OnWheelDown" MouseMove="OnWheelMove" MouseLeftButtonUp="OnWheelUp">
                        <Image x:Name="Wheel" Width="180" Height="180" Stretch="None" IsHitTestVisible="False"/>
                        <Canvas Width="180" Height="180" IsHitTestVisible="False">
                            <Ellipse x:Name="Marker" Width="14" Height="14" Stroke="White" StrokeThickness="2" Fill="Transparent">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.9"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>
                    <TextBlock Text="Brightness" Margin="0,8,0,0" Foreground="{DynamicResource TextMutedBrush}"/>
                    <Slider x:Name="Brightness" Minimum="0" Maximum="1" Value="1" ValueChanged="OnBrightnessChanged"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border x:Name="Preview" Width="22" Height="22" CornerRadius="6" BorderThickness="1" Margin="0,0,8,0"
                                BorderBrush="{DynamicResource BorderSoftBrush}"/>
                        <TextBlock x:Name="HexReadout" FontFamily="Consolas" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
