<overlays:OverlayWindowBase x:Class="EQOverwatch.App.Overlays.DpsOverlayWindow"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:overlays="clr-namespace:EQOverwatch.App.Overlays"
                            xmlns:vm="clr-namespace:EQOverwatch.App.ViewModels"
                            Title="EQ Overwatch DPS"
                            OverlayName="DPS"
                            WindowStartupLocation="Manual"
                            Left="450" Top="100"
                            Width="300" Height="230"
                            MinWidth="240" MinHeight="90">
    <Grid>
        <Border Style="{StaticResource OverlayBackdropStyle}"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource OverlayTitleStripStyle}"
                    MouseLeftButtonDown="OnTitleStripMouseDown">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource OverlayStripButtonStyle}" Click="OnCloseClick" ToolTip="Close this overlay (switch it back on in Settings)"/>
                    <Button DockPanel.Dock="Right" Content="—" Style="{StaticResource OverlayStripButtonStyle}" Click="OnMinimizeClick" ToolTip="Minimize to the title strip"/>
                    <Button DockPanel.Dock="Right" Content="Img" Style="{StaticResource OverlayChipButtonStyle}"
                            ToolTip="Copy this fight as a picture for Discord"
                            Command="{Binding CopyImageCommand}"/>
                    <Button DockPanel.Dock="Right" Content="Chat" Style="{StaticResource OverlayChipButtonStyle}"
                            ToolTip="Copy the top 12 attackers for EverQuest chat"
                            Command="{Binding CopyChatCommand}"/>
                    <TextBlock Margin="6,0"
                               Style="{StaticResource OverlayTextStyle}"
                               Text="{Binding OverlayName, RelativeSource={RelativeSource AncestorType={x:Type overlays:OverlayWindowBase}}}"/>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="4" ClipToBounds="True">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <!-- An encounter that has ended is shown dimmed. -->
                            <DataTrigger Binding="{Binding IsLive}" Value="False">
                                <Setter Property="Opacity" Value="0.65"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Header: target, encounter length, group DPS -->
                <Border Padding="6,3" CornerRadius="3" Background="{DynamicResource RowBackdropBrush}">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource OverlayTextStyle}"/>
                            <TextBlock Text="{Binding GroupDpsText}" Margin="10,0,0,0" Foreground="{DynamicResource AlertTextBrush}" Style="{StaticResource OverlayTextStyle}"/>
                            <TextBlock Text=" DPS" Style="{StaticResource OverlayMutedTextStyle}"/>
                        </StackPanel>
                        <!-- The mob's estimated regen and hit points, from its recorded kills (empty when there are too few) -->
                        <TextBlock DockPanel.Dock="Right" Text="{Binding RegenText}" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" Style="{StaticResource OverlayTextStyle}" Foreground="{DynamicResource RegenTextBrush}"/>
                        <TextBlock Text="{Binding TargetName}" TextTrimming="CharacterEllipsis" Style="{StaticResource OverlayTextStyle}"/>
                    </DockPanel>
                </Border>

                <!-- The raid out-damages the mob's regen by too little -->
                <TextBlock Margin="6,2,6,0" Text="DPS too low for its regen" FontSize="11" Foreground="{DynamicResource BarUrgentFillBrush}"
                           Style="{StaticResource OverlayTextStyle}"
                           Visibility="{Binding RegenWarning, Converter={StaticResource BoolToVisibility}}"/>

                <!-- A boss nobody on the server has killed yet -->
                <TextBlock Margin="6,2,6,0" Text="★ Server first possible" FontSize="11" Foreground="{DynamicResource AlertTextBrush}"
                           Style="{StaticResource OverlayTextStyle}"
                           Visibility="{Binding IsFirstPossible, Converter={StaticResource BoolToVisibility}}"/>

                <!-- How far along the fight is, from the recorded kills of this mob (hidden when there are too few) -->
                <StackPanel Margin="6,3,6,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProgressText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ProgressBar Height="5" Minimum="0" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource RowBackdropBrush}" BorderThickness="0"/>
                    <TextBlock Margin="0,2,0,0" Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" Style="{StaticResource OverlayMutedTextStyle}"/>
                </StackPanel>

                <!-- Column captions -->
                <Grid Margin="6,3,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Cls" HorizontalAlignment="Center" Style="{StaticResource OverlayMutedTextStyle}"/>
                    <TextBlock Grid.Column="2" Text="SDPS" HorizontalAlignment="Right" Style="{StaticResource OverlayMutedTextStyle}"/>
                    <TextBlock Grid.Column="3" Text="Total" HorizontalAlignment="Right" Style="{StaticResource OverlayMutedTextStyle}"/>
                    <TextBlock Grid.Column="4" Text="%" HorizontalAlignment="Right" Style="{StaticResource OverlayMutedTextStyle}"/>
                </Grid>

                <!-- Ranked rows with relative fill bars -->
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DpsRowViewModel}">
                            <Grid Height="20">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Margin" Value="0,1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StartsMineSection}" Value="True">
                                                <Setter Property="Margin" Value="0,7,0,1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Border Background="{DynamicResource BarBackBrush}" CornerRadius="3"/>
                                <Border CornerRadius="3" RenderTransformOrigin="0,0.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource DpsFillBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                    <Setter Property="Background" Value="#B3D9A441"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding Fill}"/>
                                    </Border.RenderTransform>
                                </Border>
                                <Grid Margin="6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding RankName}" TextTrimming="CharacterEllipsis" Style="{StaticResource OverlayTextStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ClassText}" HorizontalAlignment="Center" Style="{StaticResource OverlayMutedTextStyle}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SdpsText}" HorizontalAlignment="Right" Style="{StaticResource OverlayTextStyle}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding TotalText}" HorizontalAlignment="Right" Style="{StaticResource OverlayTextStyle}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding PercentText}" HorizontalAlignment="Right" Style="{StaticResource OverlayTextStyle}"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <Rectangle Style="{StaticResource OverlayDashedBorderStyle}"/>
    </Grid>
</overlays:OverlayWindowBase>
