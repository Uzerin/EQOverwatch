<Window x:Class="EQOverwatch.App.CharacterDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:EQOverwatch.App.Controls"
        Title="{Binding Title}"
        Icon="pack://application:,,,/Assets/EQOverwatch.ico"
        Width="1000" Height="700"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- One inventory slot: a drawn slot icon or a lettered item tile, its count, and its augment sockets. -->
        <DataTemplate x:Key="SlotTemplate">
            <Button Width="54" Height="54" Margin="0,0,4,4" Padding="0" Cursor="Arrow" ToolTip="{Binding ToolTip}"
                    Command="{Binding DataContext.InventoryPanel.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderSoftBrush}"
                                Background="{DynamicResource WindowBgBrush}">
                            <Grid>
                                <Path Width="26" Height="26" Stretch="Uniform" Data="{Binding Glyph}" Stroke="{Binding GlyphBrush}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="{Binding ShowGlyph, Converter={StaticResource BoolToVisibility}}"/>
                                <Border Width="34" Height="34" CornerRadius="7" BorderThickness="1" Background="{Binding TileFill}" BorderBrush="{Binding TileInk}"
                                        Visibility="{Binding ShowTile, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Initials}" Foreground="{Binding TileInk}" FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding CountText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,1"/>
                                <ItemsControl ItemsSource="{Binding Augments}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3,0,0,3"
                                              Visibility="{Binding HasAugments, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="9" Height="9" Margin="0,0,2,0" CornerRadius="2" BorderThickness="1"
                                                    BorderBrush="{DynamicResource TextMutedBrush}" Background="{DynamicResource CardBgBrush}">
                                                <Ellipse x:Name="Dot" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="True">
                                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsBag}" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <Style x:Key="SectionTab" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Padding="10,4" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderSoftBrush}" Background="Transparent">
                            <ContentPresenter x:Name="Text" TextElement.Foreground="{DynamicResource TextMutedBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Text" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NumericCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="2,3"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">

        <!-- The account the character is on: links its shared bank with the other characters on the account. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVisibility}}">
            <TextBlock DockPanel.Dock="Left" Text="Account" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox DockPanel.Dock="Left" Width="200" Style="{StaticResource SearchComboBox}" ItemsSource="{Binding AccountNames}" VerticalAlignment="Center"
                      Text="{Binding AccountName, UpdateSourceTrigger=LostFocus}"
                      ToolTip="Type a name for the EverQuest account this character is on. Characters with the same account name share one shared bank. Leave it empty to group characters whose shared banks look the same."/>
            <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="14,0,0,0" Text="{Binding AccountMembers}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- The character's level over time, from its log. -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding HasLevelHistory, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Level history" Style="{StaticResource HintText}" Margin="0,0,0,2"/>
            <ctl:LevelHistoryControl Levels="{Binding LevelHistory, Mode=OneWay}" Height="90" MaxWidth="560" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- The class persona the per-persona tabs show. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding HasPersonas, Converter={StaticResource BoolToVisibility}}">
            <TextBlock DockPanel.Dock="Left" Text="Persona" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox DockPanel.Dock="Left" Width="200" ItemsSource="{Binding PersonaChoices}" SelectedItem="{Binding SelectedPersona, Mode=TwoWay}"
                      DisplayMemberPath="Label" VerticalAlignment="Center"/>
            <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="14,0,0,0"
                       Text="Worn gear, Spellbook, Missing Spells, Focus Effects, Skills and Faction follow the persona. Bags, Bank, Key Ring and Tradeskills are shared by all personas."/>
        </DockPanel>

        <!-- Filter, refresh and where the data came from. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Forget this character" Command="{Binding ForgetCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="12,4"
                    ToolTip="Forget the inventory, spellbook and missing spells saved for this character (they come back if the files are read again)"
                    Visibility="{Binding CanForget, Converter={StaticResource BoolToVisibility}}"/>
            <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="12,4"
                    ToolTip="Read this character's /outputfile files from the EverQuest folder again"/>
            <TextBlock DockPanel.Dock="Left" Text="Filter" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox DockPanel.Dock="Left" Width="240" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Narrows the table you are looking at" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding SourceText}" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="14,0,0,0"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <TabItem Header="Inventory">
                <DockPanel Margin="0,6,0,0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintText}" Margin="0,0,0,6" TextWrapping="Wrap" Text="{Binding InventoryNote}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MaxWidth="560"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                <DataGrid Grid.Column="0" HorizontalAlignment="Left" ItemsSource="{Binding InventoryRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Where" Binding="{Binding Where, Mode=OneWay}" Width="Auto"/>
                        <DataGridTextColumn Header="Item" Binding="{Binding Item, Mode=OneWay}" Width="Auto"/>
                        <DataGridTextColumn Header="ID" Binding="{Binding ItemId, Mode=OneWay}" Width="Auto"
                                            ElementStyle="{StaticResource NumericCell}"/>
                        <DataGridTextColumn Header="Count" Binding="{Binding Count, Mode=OneWay}" Width="Auto"
                                            ElementStyle="{StaticResource NumericCell}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- The inventory as the game shows it. -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" DataContext="{Binding InventoryPanel}">
                    <Border Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource BorderSoftBrush}" Background="{DynamicResource CardBgBrush}"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton GroupName="InvSection" Style="{StaticResource SectionTab}" Content="Inventory" IsChecked="{Binding IsInventorySection, Mode=TwoWay}"/>
                                <RadioButton GroupName="InvSection" Style="{StaticResource SectionTab}" Content="Bank" IsChecked="{Binding IsBankSection, Mode=TwoWay}"/>
                                <RadioButton GroupName="InvSection" Style="{StaticResource SectionTab}" Content="Shared Bank" IsChecked="{Binding IsSharedBankSection, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,16,0" Visibility="{Binding ShowWorn, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding WornTitle}" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding Worn}" ItemTemplate="{StaticResource SlotTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding ContainersTitle}" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding Containers}" ItemTemplate="{StaticResource SlotTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel MaxWidth="{Binding DataContext.ContainerPanelWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding HasOpenBag, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding OpenTitle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding OpenContents}" ItemTemplate="{StaticResource SlotTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel MaxWidth="464"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource HintText}" MaxWidth="460" HorizontalAlignment="Left"
                                       Text="Hover a slot for the item, its count and its augment sockets (a dot means an augment is in it)."/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
                </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Spellbook">
                <DockPanel Margin="0,6,0,0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintText}" Margin="0,0,0,6" Text="{Binding SpellbookNote}"/>
                <DataGrid HorizontalAlignment="Left" ItemsSource="{Binding SpellbookRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Level" Binding="{Binding Level, Mode=OneWay}" Width="Auto"
                                            ElementStyle="{StaticResource NumericCell}"/>
                        <DataGridTextColumn Header="Spell" Binding="{Binding Name, Mode=OneWay}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Missing Spells">
                <DockPanel Margin="0,6,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <CheckBox DockPanel.Dock="Right" Content="Only spells with a scroll on hand" IsChecked="{Binding OnlyWithScroll}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding MissingSummary}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding MissingRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level, Mode=OneWay}" Width="Auto"
                                                ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Spell" Binding="{Binding Name, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Scroll on hand (same server)" Binding="{Binding Scroll, Mode=OneWay}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Key Ring">
                <DataGrid Margin="0,6,0,0" ItemsSource="{Binding KeyRingRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type, Mode=OneWay}" Width="Auto"/>
                        <DataGridTextColumn Header="Item" Binding="{Binding Name, Mode=OneWay}" Width="Auto"/>
                        <DataGridTextColumn Header="ID" Binding="{Binding ItemId, Mode=OneWay}" Width="Auto"
                                            ElementStyle="{StaticResource NumericCell}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Focus Effects" DataContext="{Binding Focus}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,10" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Message}" Style="{StaticResource HintText}" Margin="0,0,0,10"
                                   Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}"/>
                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSoftBrush}" HorizontalAlignment="Left">
                            <StackPanel Grid.IsSharedSizeScope="True">
                                <Grid TextElement.Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FkType"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FkPick"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FkBenefit"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FkSeen"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Focus type" Margin="4,4,16,4"/>
                                    <TextBlock Grid.Column="1" Text="Your focus (open and type to jump)" Margin="4,4,16,4"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LevelHeading}" Margin="4,4,16,4"/>
                                    <TextBlock Grid.Column="3" Text="Seen in your log" Margin="4,4,16,4"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSoftBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FkType"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FkPick"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FkBenefit"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FkSeen"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center" Margin="4,4,16,4"/>
                                                    <ComboBox Grid.Column="1" Width="330" Margin="4,3,16,3" IsEditable="False" IsTextSearchEnabled="True" ToolTip="Open the list and type the start of a name to jump to it."
                                                              ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedItem="{Binding Selected, Mode=TwoWay}">
                                                        <ComboBox.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <VirtualizingStackPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ComboBox.ItemsPanel>
                                                    </ComboBox>
                                                    <TextBlock Grid.Column="2" Text="{Binding BenefitText}" Foreground="#5CC98A" TextWrapping="Wrap" MaxWidth="420"
                                                               VerticalAlignment="Center" Margin="4,4,16,4"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Seen}" Style="{StaticResource HintText}" TextWrapping="Wrap" MaxWidth="280"
                                                               VerticalAlignment="Center" Margin="4,4,16,4"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Duration AAs" FontWeight="SemiBold" Margin="0,14,0,3"/>
                        <TextBlock Text="{Binding DurationAasText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                                   Text="Each focus is checked against its own limits: the highest spell level it fully works on (and how much it loses per level above), beneficial or detrimental spells, and the spells it leaves out. The two duration foci and your learned AAs lengthen your timer bars; the others are for reference. Seen in your log lists items whose focus message came in this character's log."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Skills">
                <DockPanel Margin="0,6,0,0">
                    <CheckBox DockPanel.Dock="Top" Margin="0,0,0,6" Content="Only skills not maxed" IsChecked="{Binding OnlyUnmaxedSkills}"/>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}" Margin="0,6,0,0"
                               Text="From the &quot;You have become better at&quot; lines in this character's log. Max is the most the skill can be for the character's class and level, from skillcaps.txt in your EverQuest folder."/>
                    <DataGrid HorizontalAlignment="Left" ItemsSource="{Binding SkillRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Skill" Binding="{Binding Skill, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Max" Binding="{Binding Max, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Today" Binding="{Binding Today, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Last up" Binding="{Binding LastUp, Mode=OneWay}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Tradeskills">
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}" Margin="0,6,0,0"
                               Text="Each combine this character's log shows: &quot;You have fashioned the items together&quot; made it, &quot;You lacked the skills&quot; failed."/>
                    <DataGrid HorizontalAlignment="Left" ItemsSource="{Binding TradeskillRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Recipe" Binding="{Binding Recipe, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Combines" Binding="{Binding Combines, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Made" Binding="{Binding Made, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Failed" Binding="{Binding Failed, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Success" Binding="{Binding Success, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Skill-ups" Binding="{Binding SkillUps, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Combines per skill-up" Binding="{Binding PerSkillUp, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Last" Binding="{Binding Last, Mode=OneWay}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Faction">
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}" Margin="0,6,0,0"
                               Text="Standing is from /outputfile faction, moved on by the log since. The other columns are from the &quot;Your faction standing with&quot; lines in this character's log. This session counts since the app opened. Comes from is the mob whose kills change it most."/>
                    <DataGrid HorizontalAlignment="Left" ItemsSource="{Binding FactionRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Faction" Binding="{Binding Faction, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Standing" Binding="{Binding Standing, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="This session" Binding="{Binding Session, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="All time" Binding="{Binding AllTime, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Hits" Binding="{Binding Hits, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Usual hit" Binding="{Binding UsualHit, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Comes from" Binding="{Binding ComesFrom, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Flags">
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}" Margin="0,6,0,0"
                               Text="Character flags this character's log announced."/>
                    <DataGrid HorizontalAlignment="Left" ItemsSource="{Binding FlagRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Flag" Binding="{Binding Flag, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Received" Binding="{Binding Received, Mode=OneWay}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Achievements">
                <DockPanel Margin="0,6,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Category" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="260" ItemsSource="{Binding AchievementCategories}" SelectedItem="{Binding AchievementCategory, Mode=TwoWay}"/>
                        <CheckBox Content="Completed only" IsChecked="{Binding OnlyCompletedAchievements}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <TextBlock Text="{Binding AchievementSummary}" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}" Margin="0,6,0,0"
                               Text="From /output achievements; achievements completed in the log since then show as Done."/>
                    <DataGrid HorizontalAlignment="Left" ItemsSource="{Binding AchievementRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Achievement" Binding="{Binding Achievement, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Steps" Binding="{Binding Steps, Mode=OneWay}" Width="Auto"
                                                ElementStyle="{StaticResource NumericCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Challenges" Visibility="{Binding HasChallenges, Converter={StaticResource BoolToVisibility}}">
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Challenges count per character: beat the goal at or under the level. Done comes from this character's achievement lines."/>
                    <DataGrid HorizontalAlignment="Left" ItemsSource="{Binding ChallengeRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter Property="Foreground" Value="#5CC98A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Goal" Binding="{Binding Goal, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Reward" Binding="{Binding Reward, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="AAs">
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6" Text="{Binding AaSummary}" TextWrapping="Wrap"/>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Ability" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="260" IsEditable="True" IsTextSearchEnabled="True" ItemsSource="{Binding AaNameChoices}"
                                  Text="{Binding AaName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"
                                  ToolTip="Type or pick a name; the list comes from the game's files."/>
                        <TextBlock Text="Rank" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Width="50" Text="{Binding AaRank, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>
                        <Button Content="Add / Edit" Command="{Binding SaveAaCommand}" Margin="0,0,8,0"/>
                        <Button Content="Remove" Command="{Binding RemoveAaCommand}" Margin="0,0,12,0"/>
                        <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Text="{Binding AaStatus}"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Abilities come from the log's learned lines. Ones you add or edit stay until the log shows that ability learned again; then the log's rank replaces them. Pick a row to edit it."/>
                    <DataGrid HorizontalAlignment="Left" ItemsSource="{Binding AaRows}" SelectedItem="{Binding SelectedAa}" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding Description}"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="AA" Binding="{Binding Name, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Rank" Binding="{Binding Rank, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Points" Binding="{Binding Points, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Learned" Binding="{Binding Learned, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source, Mode=OneWay}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
