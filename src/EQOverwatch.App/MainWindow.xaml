                                          EnableRowVirtualization="True" SelectionMode="Single">
                                    <DataGrid.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding FilterChatPlayerCommand}"
                                                      CommandParameter="{Binding SelectedItem, ElementName=ChatGridShout}"/>
                                    </DataGrid.InputBindings>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSearchHit}" Value="True">
                                                    <Setter Property="Background" Value="#4433AADD"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMention}" Value="True">
                                                    <Setter Property="Background" Value="#55B8860B"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="When" Binding="{Binding When, Mode=OneWay}" Width="Auto"/>
                                        <DataGridTextColumn Header="Channel" Binding="{Binding Channel, Mode=OneWay}" Width="Auto"/>
                                        <DataGridTextColumn Header="Who" Binding="{Binding Speaker, Mode=OneWay}" Width="Auto"/>
                                        <DataGridTextColumn Header="Message" Binding="{Binding Text, Mode=OneWay}" Width="Auto" MaxWidth="900" ElementStyle="{StaticResource WrapCell}"/>
                                        <DataGridTextColumn Header="Seen by" Binding="{Binding Seen, Mode=OneWay}" Width="Auto"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Auction">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" Visibility="{Binding HasChatPlayer, Converter={StaticResource BoolToVisibility}}">
                                    <Button Content="Show everyone" Style="{StaticResource SecondaryButton}" Command="{Binding ClearChatPlayerCommand}" Margin="0,0,10,0"/>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ChatPlayer, StringFormat=Only Auction}"/>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding ChatStatus}"/>
                                <DataGrid x:Name="ChatGridAuction" HorizontalAlignment="Left" ItemsSource="{Binding ChatRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Disabled"
                                          EnableRowVirtualization="True" SelectionMode="Single">
                                    <DataGrid.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding FilterChatPlayerCommand}"
                                                      CommandParameter="{Binding SelectedItem, ElementName=ChatGridAuction}"/>
                                    </DataGrid.InputBindings>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSearchHit}" Value="True">
                                                    <Setter Property="Background" Value="#4433AADD"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMention}" Value="True">
                                                    <Setter Property="Background" Value="#55B8860B"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="When" Binding="{Binding When, Mode=OneWay}" Width="Auto"/>
                                        <DataGridTextColumn Header="Channel" Binding="{Binding Channel, Mode=OneWay}" Width="Auto"/>
                                        <DataGridTextColumn Header="Who" Binding="{Binding Speaker, Mode=OneWay}" Width="Auto"/>
                                        <DataGridTextColumn Header="Message" Binding="{Binding Text, Mode=OneWay}" Width="Auto" MaxWidth="900" ElementStyle="{StaticResource WrapCell}"/>
                                        <DataGridTextColumn Header="Seen by" Binding="{Binding Seen, Mode=OneWay}" Width="Auto"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Channels">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" Visibility="{Binding HasChatPlayer, Converter={StaticResource BoolToVisibility}}">
                                    <Button Content="Show everyone" Style="{StaticResource SecondaryButton}" Command="{Binding ClearChatPlayerCommand}" Margin="0,0,10,0"/>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ChatPlayer, StringFormat=Only Channels}"/>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding ChatStatus}"/>
                                <DataGrid x:Name="ChatGridChannels" HorizontalAlignment="Left" ItemsSource="{Binding ChatRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Disabled"
                                          EnableRowVirtualization="True" SelectionMode="Single">
                                    <DataGrid.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding FilterChatPlayerCommand}"
                                                      CommandParameter="{Binding SelectedItem, ElementName=ChatGridChannels}"/>
                                    </DataGrid.InputBindings>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSearchHit}" Value="True">
                                                    <Setter Property="Background" Value="#4433AADD"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMention}" Value="True">
                                                    <Setter Property="Background" Value="#55B8860B"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="When" Binding="{Binding When, Mode=OneWay}" Width="Auto"/>
                                        <DataGridTextColumn Header="Channel" Binding="{Binding Channel, Mode=OneWay}" Width="Auto"/>
                                        <DataGridTextColumn Header="Who" Binding="{Binding Speaker, Mode=OneWay}" Width="Auto"/>
                                        <DataGridTextColumn Header="Message" Binding="{Binding Text, Mode=OneWay}" Width="Auto" MaxWidth="900" ElementStyle="{StaticResource WrapCell}"/>
                                        <DataGridTextColumn Header="Seen by" Binding="{Binding Seen, Mode=OneWay}" Width="Auto"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                </TabControl>
                </DockPanel>
            </TabItem>

            <TabItem Header="Players &amp; Pets">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Style="{StaticResource HintText}" Margin="0,0,0,8"
                               Text="Classes come from /who. To link a pet to its owner, target the pet and type /pet leader; the pet answers &quot;My leader is Name.&quot; and the app remembers it."/>
                    <CheckBox Grid.Row="1" Content="Count a pet's damage under its owner" IsChecked="{Binding MergePetDamage}" Margin="0,0,0,8"
                              ToolTip="Applies to fights parsed from now on. Off lists each pet on its own row."/>
                    <TextBlock Grid.Row="2" Text="{Binding RosterSummary}" Style="{StaticResource HintText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="320"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*" MinWidth="320"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabel}" Text="Players"/>
                                <TextBox Margin="0,0,0,6" VerticalAlignment="Center" Text="{Binding PlayerSearch, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Type part of a name to narrow the list."/>
                            </DockPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding RosterPlayers}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="Auto"/>
                                    <DataGridTextColumn Header="Server" Binding="{Binding Server}" Width="Auto"/>
                                    <DataGridTextColumn Header="Level" Binding="{Binding LevelText, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                    <DataGridTextColumn Header="Class" Binding="{Binding Class}" Width="Auto"/>
                                    <DataGridTextColumn Header="Pets" Binding="{Binding Pets}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                                <Button DockPanel.Dock="Right" Content="Forget all pets" Command="{Binding ForgetAllPetsCommand}" Style="{StaticResource SecondaryButton}"
                                        ToolTip="Clears the pet list. Pets are learned again from /pet leader lines."/>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabel}" Text="Pets" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding RosterPets}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Pet" Binding="{Binding Pet}" Width="Auto"/>
                                    <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="Auto"/>
                                    <DataGridTextColumn Header="Server" Binding="{Binding Server}" Width="Auto"/>
                                    <DataGridTemplateColumn Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Forget" Style="{StaticResource SecondaryButton}"
                                                        Command="{Binding DataContext.ForgetPetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═════════ Tab 6: Settings ═════════ -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <presentation:ResponsiveColumnsPanel Margin="6,6,14,6" MinColumnWidth="430" MaxColumns="3" ColumnGap="12">

                        <GroupBox Header="EverQuest game folder">
                            <StackPanel Margin="4">
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="↻ Refresh" Command="{Binding RefreshEqFolderCommand}"
                                            Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                                            ToolTip="Looks for new character logs and reloads spells_us.txt."/>
                                    <Button DockPanel.Dock="Left" Content="Set EverQuest Folder…" Command="{Binding SetEqFolderCommand}" Margin="0,0,10,0"/>
                                    <TextBox IsReadOnly="True" VerticalAlignment="Center" Text="{Binding EqFolderPath, Mode=OneWay}"/>
                                </DockPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Default Caster Level"/>
                                    <TextBox Width="56" VerticalAlignment="Center"
                                             ToolTip="Durations are calculated for this caster level (focus and AA extensions are not included)."
                                             Text="{Binding DefaultCasterLevel, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Text="1-125" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,24,0"/>
                                    <Button Content="Choose spell file…" Command="{Binding BrowseSpellsCommand}" Style="{StaticResource SecondaryButton}"
                                            ToolTip="Only needed if spells_us.txt is not in the EverQuest folder."/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource HintText}" Text="{Binding EqFolderStatus}"/>
                                <TextBlock Style="{StaticResource HintText}" Text="{Binding SpellsStatus}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Several PCs">
                            <StackPanel Margin="4">
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Run Overwatch on your other PCs and see all of your characters' inventories and spells on your main PC. The PCs must be on the same home network."/>
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="This PC"/>
                                    <ComboBox Width="280" ItemsSource="{Binding SyncModes}" SelectedIndex="{Binding SyncModeIndex}"/>
                                </WrapPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Pairing code"
                                               ToolTip="The main PC makes the code. Type the same code into each of your other PCs."/>
                                    <TextBox Width="150" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding SyncCode, UpdateSourceTrigger=LostFocus}"/>
                                    <Button Content="New code" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding NewSyncCodeCommand}"
                                            ToolTip="Makes a new code. PCs using the old one are no longer accepted."/>
                                    <Button Content="Copy" Style="{StaticResource SecondaryButton}" Command="{Binding CopySyncCodeCommand}"/>
                                </WrapPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="This PC's name"/>
                                    <TextBox Width="150" VerticalAlignment="Center" Margin="0,0,14,0" Text="{Binding SyncPcName, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Main PC address"
                                               ToolTip="Leave empty to find the main PC automatically. Only needed if it is not found."/>
                                    <TextBox Width="130" VerticalAlignment="Center" Text="{Binding SyncHostAddress, UpdateSourceTrigger=LostFocus}"/>
                                </WrapPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="Send now" Margin="0,0,8,0" Command="{Binding SendCharacterFilesNowCommand}"
                                            ToolTip="Sends every character file from this PC to the main PC again."/>
                                    <Button Content="Find main PC" Style="{StaticResource SecondaryButton}" Command="{Binding FindMainPcCommand}"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding SyncStatus}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Overlay layouts">
                            <StackPanel Margin="4">
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Save where your overlays are now (position, size, shown and locked), and switch back to it later. Handy when you play on a different monitor setup."/>
                                <WrapPanel Margin="0,0,0,8">
                                    <ComboBox Width="190" Margin="0,0,8,0" ItemsSource="{Binding OverlayProfileNames}" SelectedItem="{Binding SelectedOverlayProfile}"/>
                                    <Button Content="Apply" Margin="0,0,8,0" Command="{Binding ApplyOverlayProfileCommand}"/>
                                    <Button Content="Delete" Style="{StaticResource SecondaryButton}" Command="{Binding DeleteOverlayProfileCommand}"/>
                                </WrapPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBox Width="190" Margin="0,0,8,0" VerticalAlignment="Center"
                                             ToolTip="A name for the layout you have now, for example Two monitors"
                                             Text="{Binding NewOverlayProfileName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Content="Save current layout" Style="{StaticResource SecondaryButton}" Command="{Binding SaveOverlayProfileCommand}"/>
                                </WrapPanel>
                                <CheckBox Content="Switch automatically when the monitors change" IsChecked="{Binding AutoSwitchOverlayProfiles}" Margin="0,0,0,6"
                                          ToolTip="Uses the newest saved layout that was made for the monitor setup you have now. Off by default."/>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding OverlayProfileStatus}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Backup &amp; restore">
                            <StackPanel Margin="4">
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="Back up…" Margin="0,0,8,0" Command="{Binding ExportBackupCommand}"
                                            ToolTip="Saves your settings, triggers, loot, attendance, characters and mob history in one zip file."/>
                                    <Button Content="Restore…" Style="{StaticResource SecondaryButton}" Command="{Binding RestoreBackupCommand}"
                                            ToolTip="Replaces your data with a backup. It takes effect the next time the app starts."/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding BackupStatus}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Overlay windows">
                            <StackPanel Margin="4">
                                <WrapPanel>
                                    <CheckBox Content="Buffs" IsChecked="{Binding IsBuffsOverlayVisible}" Margin="0,0,20,6"/>
                                    <CheckBox Content="Debuffs" IsChecked="{Binding IsDebuffsOverlayVisible}" Margin="0,0,20,6"/>
                                    <CheckBox Content="Songs" IsChecked="{Binding IsSongsOverlayVisible}" Margin="0,0,20,6"/>
                                    <CheckBox Content="Raid Triggers" IsChecked="{Binding IsRaidTriggersOverlayVisible}" Margin="0,0,20,6"/>
                                    <CheckBox Content="CH Chain" IsChecked="{Binding IsChChainOverlayVisible}" Margin="0,0,20,6"/>
                                    <CheckBox Content="DPS" IsChecked="{Binding IsDpsOverlayVisible}" Margin="0,0,20,6"/>
                                    <CheckBox Content="Tells" IsChecked="{Binding IsTellsOverlayVisible}" Margin="0,0,20,6"
                                              ToolTip="Your characters' unanswered tells. It stays fully visible out of combat."/>
                                    <CheckBox Content="Tell notifications" IsChecked="{Binding TellToast}" Margin="0,0,20,6"
                                              ToolTip="A Windows notification when a tell arrives while EverQuest is not the active window."/>
                                    <CheckBox Content="Level-up notifications" IsChecked="{Binding LevelUpToast}" Margin="0,0,20,6"
                                              ToolTip="A Windows notification when one of your characters gains a level while EverQuest is not the active window."/>
                                    <CheckBox Content="Rolls and linkdead on Tells" IsChecked="{Binding TellsOverlayNotices}" Margin="0,0,20,6"
                                              ToolTip="Shows /random rolls and players gone linkdead on the Tells overlay for 30 seconds."/>
                                    <CheckBox Content="Mob Card" IsChecked="{Binding IsMobCardOverlayVisible}" Margin="0,0,20,6"
                                              ToolTip="When you /con a mob: its kills and times on your server, the raid's resist rates and its drops, for 10 seconds."/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="With the CH Chain overlay off, Complete Heal chain bars and the late-cast alarm are shown in the Buffs overlay instead."/>
                                <TextBlock Margin="0,10,0,4" FontWeight="SemiBold" Text="Floating combat text"/>
                                <WrapPanel>
                                    <CheckBox Content="Damage" IsChecked="{Binding IsFctDamageOverlayVisible}" VerticalAlignment="Center" Margin="0,0,6,6"
                                              ToolTip="Damage you deal on the left, damage you take on the right."/>
                                    <TextBox Width="64" Margin="0,0,20,6" HorizontalContentAlignment="Center" Text="{Binding FctDamageTextSize}" ToolTip="Text size of the numbers (10 to 48)."/>
                                    <CheckBox Content="Heals" IsChecked="{Binding IsFctHealsOverlayVisible}" VerticalAlignment="Center" Margin="0,0,6,6"
                                              ToolTip="Heals you cast on others on the left, heals you receive on the right."/>
                                    <TextBox Width="64" Margin="0,0,20,6" HorizontalContentAlignment="Center" Text="{Binding FctHealsTextSize}" ToolTip="Text size of the numbers (10 to 48)."/>
                                    <CheckBox Content="Merge rapid hits" IsChecked="{Binding FctMergeHits}" VerticalAlignment="Center" Margin="0,0,20,6"
                                              ToolTip="Hits within 0.3 seconds from one character on one target show as one number, like 3,412 x4."/>
                                    <CheckBox Content="Show misses" IsChecked="{Binding FctShowMisses}" VerticalAlignment="Center" Margin="0,0,20,6"
                                              ToolTip="Dodge, Parry, Block, Riposte, Miss and Resisted show as small gray words."/>
                                    <TextBlock Text="Font" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                    <ComboBox Width="130" Margin="0,0,8,6" ItemsSource="{Binding FctFontChoices}" SelectedItem="{Binding FctFont}"/>
                                    <ComboBox Width="120" Margin="0,0,20,6" ItemsSource="{Binding FctWeightChoices}" SelectedItem="{Binding FctWeight}"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="New numbers appear at the top and push older ones down; each fades over 3 seconds and crits are bold. Left lane: what your character deals or casts. Right lane: what it takes or receives. The boxes are text sizes; colors are in the Colors window."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Historical fights &amp; DPS">
                            <StackPanel Margin="4">
                                <WrapPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Historical Days to Load"/>
                                    <ComboBox Width="140" Margin="0,0,28,6"
                                              ItemsSource="{Binding HistoricalDaysOptions}" DisplayMemberPath="Display" SelectedValuePath="Days"
                                              SelectedValue="{Binding HistoricalDaysLimit}"/>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Encounter Timeout Seconds"
                                               ToolTip="An encounter ends after this many log seconds without activity. Applies to new events; reload history to re-split old fights."/>
                                    <TextBox Width="64" VerticalAlignment="Center" Margin="0,0,0,6"
                                             Text="{Binding EncounterTimeoutSeconds, UpdateSourceTrigger=LostFocus, StringFormat=0.##}"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="When the app opens it loads every character's recent log into the DPS meter, so a fight already in progress shows as if the app had been open all along. A hit seen in several logs counts once. All fights, live and imported, share one list on the DPS tab, newest first."/>
                                <WrapPanel>
                                    <Button Content="Reload All Logs" Margin="0,4,12,4" Command="{Binding ReloadHistoryCommand}"
                                            ToolTip="Reads every character's log again for the Historical Days to Load, and adds the fights to Mob History."/>
                                    <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Text="{Binding ImportStatus}"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Box alerts">
                            <StackPanel Margin="4">
                                <CheckBox Content="Aggro alert" Margin="0,2,0,6" IsChecked="{Binding AggroAlert}"
                                          ToolTip="Says and shows &quot;Plethora is being attacked by Yasiz the Devourer&quot; when a mob in a fight attacks one of your characters without the Tank box (Characters tab). Rampage hits don't count."/>
                                <CheckBox Content="Range alert" Margin="0,0,0,6" IsChecked="{Binding RangeAlert}"
                                          ToolTip="Says &quot;Myriad out of range&quot; or &quot;Myriad can't see the target&quot; when one of your characters can't reach its target during a fight."/>
                                <CheckBox Content="Follow alert" Margin="0,0,0,6" IsChecked="{Binding FollowAlert}"
                                          ToolTip="Says &quot;Myriad stopped following&quot; when one of your characters stops auto-following."/>
                                <CheckBox Content="Pet buff faded" Margin="0,0,0,6" IsChecked="{Binding PetBuffAlert}"
                                          ToolTip="Says &quot;pet Storm Strength faded&quot; when a buff on one of your pets wears off."/>
                                <CheckBox Content="Show how far along a fight is on the DPS overlay" Margin="0,0,0,6" IsChecked="{Binding ShowFightProgress}"
                                          ToolTip="A bar and &quot;~62% · about 1:40 left&quot;, from the damage the recorded kills of the same mob took on this server (needs 2 kills)."/>
                                <CheckBox Content="Buff didn't take hold" Margin="0,0,0,6" IsChecked="{Binding TakeHoldAlert}"
                                          ToolTip="Says which buff blocked yours, at most once a minute per spell."/>
                                <CheckBox Content="Resist streak" Margin="0,0,0,6" IsChecked="{Binding ResistStreakAlert}"
                                          ToolTip="Says when the same mob resisted one of your spells 3 times in a row."/>
                                <CheckBox Content="Feign death failed" Margin="0,0,0,6" IsChecked="{Binding FeignDeathAlert}"
                                          ToolTip="Says when one of your characters fell to the ground instead of feigning."/>
                                <CheckBox Content="Root or mez broke" Margin="0,0,0,6" IsChecked="{Binding RootMezAlert}"
                                          ToolTip="Says when your root or mez wears off or breaks."/>
                                <CheckBox Content="Log went quiet" Margin="0,0,0,6" IsChecked="{Binding QuietLogAlert}"
                                          ToolTip="Says when a character's log has had no lines for 2 minutes during a fight (a disconnect or crash)."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Charm watch">
                            <StackPanel>
                                <CheckBox Content="Watch my characters' charms" Margin="0,2,0,6" IsChecked="{Binding CharmWatchEnabled}"
                                          ToolTip="A countdown bar on the Debuffs overlay while your character's charm lasts, and a red CHARM BROKE banner and a spoken Charm broke when it breaks."/>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                           Text="Only your own charms: the game tells only the caster when a charm breaks. Uses the trigger voice and the Mute audio switch."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Tells">
                            <StackPanel>
                                <CheckBox Content="Read tells aloud" Margin="0,2,0,6" IsChecked="{Binding ReadTellsAloud}"
                                          ToolTip="Speaks 'Name tells Character: message' when anyone sends a tell to a character you are watching."/>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                           Text="Uses the same voice, volume and Mute audio switch as trigger audio. Only new tells are spoken, from every character log you watch. Messages longer than 200 characters are cut off."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Cleric CH chain">
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Margin" Value="0,3"/>
                                    </Style>
                                </Grid.Resources>

                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Position Tag Format"/>
                                <TextBox Grid.Row="0" Grid.Column="1" FontFamily="Consolas"
                                         ToolTip="Each {N} is the cleric's position: {N}-{N}-{N} gives 3-3-3"
                                         Text="{Binding ChainPositionTagFormat, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource ErrorText}"
                                           Text="{Binding ChainTagError}"/>

                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Cue Statement / Keyword"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ChainCueKeyword, UpdateSourceTrigger=PropertyChanged}"/>


                                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Late Cast Alert Threshold Seconds"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                         Text="{Binding ChainLateThresholdSeconds, UpdateSourceTrigger=LostFocus, StringFormat=0.##}"/>

                                <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource HintText}" Margin="0,8,0,0"
                                           Text="When another cleric says your position tag together with the cue (for example &quot;3-3-3 CAST NOW!&quot;; any letter case) and you have not begun casting Complete Heal within the threshold, a flashing &quot;CAST CH NOW!&quot; banner and a spoken alarm repeat every second until you do. Pick your position on the Characters tab."/>
                                <Button Grid.Row="5" Grid.ColumnSpan="3" HorizontalAlignment="Left" Margin="0,8,0,0" Content="Advanced…"
                                        Style="{StaticResource SecondaryButton}" Command="{Binding OpenAutoClickAdvancedCommand}"
                                        ToolTip="Auto-press on your CH turn: switch, timing, CH key, assist key and hotkey."/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Buff timers in safe zones">
                            <StackPanel Margin="4">
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="The game does not tick buffs and debuffs while a character is in one of these zones, so their bars stop and carry on when the character leaves. One zone per line; a leading &quot;The&quot; and capitals do not matter. A character that dies loses its bars, and a character that logs out has its bars hidden and stopped until it logs in again."/>
                                <TextBox Height="96" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                         Text="{Binding SafeZonesText, UpdateSourceTrigger=LostFocus}"/>
                                <Button Content="Reset to the built-in list" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,2"
                                        Style="{StaticResource SecondaryButton}" Command="{Binding ResetSafeZonesCommand}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Overlay fading">
                            <StackPanel Margin="4">
                                <WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,32,6">
                                        <TextBlock Text="Overlays out of combat (% visible)" VerticalAlignment="Center" Margin="0,0,8,0"
                                                   ToolTip="How see-through every overlay gets when no combat line has been seen for 10 seconds. 100 = no fading. The overlays are always fully shown while unlocked."/>
                                        <TextBox Width="50" Text="{Binding OverlayIdlePercent, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                        <TextBlock Text="Hide DPS overlay after (seconds)" VerticalAlignment="Center" Margin="0,0,8,0"
                                                   ToolTip="The DPS overlay goes away when no combat line has been seen for this long, and comes back with the next one. 0 keeps it up."/>
                                        <TextBox Width="50" Text="{Binding DpsHideSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="The colors of the Discord picture are on the Encounter DPS tab (Colors...)."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Theme &amp; colors">
                            <StackPanel Margin="4">
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="Obsidian Slate" Style="{StaticResource PresetPill}" Margin="0,0,8,4"
                                            Command="{Binding SelectThemePresetCommand}" CommandParameter="ObsidianSlate"
                                            Tag="{Binding IsObsidianSlateSelected}"/>
                                    <Button Content="Velious Frost" Style="{StaticResource PresetPill}" Margin="0,0,8,4"
                                            Command="{Binding SelectThemePresetCommand}" CommandParameter="VeliousFrost"
                                            Tag="{Binding IsVeliousFrostSelected}"/>
                                    <Button Content="Kunark Ember" Style="{StaticResource PresetPill}" Margin="0,0,8,4"
                                            Command="{Binding SelectThemePresetCommand}" CommandParameter="KunarkEmber"
                                            Tag="{Binding IsKunarkEmberSelected}"/>
                                    <Button Content="Custom" Style="{StaticResource PresetPill}" Margin="0,0,8,4"
                                            Command="{Binding SelectThemePresetCommand}" CommandParameter="Custom"
                                            Tag="{Binding IsCustomThemeSelected}"/>
                                    <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="8,0,0,4"
                                               Text="Click a swatch to pick a color from a wheel (or type #RRGGBB) to start a custom theme. It applies to every window straight away."/>
                                </WrapPanel>

                <ItemsControl ItemsSource="{Binding ThemeColors}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,6">
                                <ctl:ColorSwatchPicker Width="24" Height="24" Margin="0,0,8,0" Hex="{Binding HexText, Mode=TwoWay}"/>
                                <TextBlock Text="{Binding Label}" Width="118" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBox Width="96" FontFamily="Consolas" Text="{Binding HexText, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DebuffsBarBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                            </StackPanel>
                        </GroupBox>


                        <GroupBox Header="Sharing">
                            <StackPanel Margin="4" MaxWidth="820" HorizontalAlignment="Left">
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Every switch that sends or downloads shared data is here. Drops, leveling and the player count send no names. Server First is the only one that shares names, and it starts off."/>

                                <TextBlock FontWeight="SemiBold" Text="Drops"/>
                                <WrapPanel Margin="0,4,0,2">
                                    <CheckBox Content="Use shared drops" IsChecked="{Binding UseSharedDrops, Mode=TwoWay}" Margin="0,0,18,4"
                                              ToolTip="Adds everyone's merged drops to the Drop Table (Source: You and all players). Downloaded after each daily merge."/>
                                    <CheckBox Content="Share my drops" IsChecked="{Binding ShareMyDrops, Mode=TwoWay}" Margin="0,0,18,4"
                                              ToolTip="Uploads your new kills and drops once a day: mob, item, zone and time under a random id. Switching it off takes them down."/>
                                    <Button Content="Delete my shared drops" Command="{Binding DeleteMySharedDropsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,4"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,12" Text="{Binding SharedDropsStatus}"/>

                                <TextBlock FontWeight="SemiBold" Text="Leveling"/>
                                <WrapPanel Margin="0,4,0,2">
                                    <CheckBox Content="Use everyone's shared leveling" IsChecked="{Binding UseSharedLeveling}" Margin="0,0,18,4"
                                              ToolTip="Downloads what other players shared for your servers: time, experience, kills and coin per zone and level band. No names."/>
                                    <CheckBox Content="Share my leveling" IsChecked="{Binding ShareMyLeveling}" Margin="0,0,18,4"
                                              ToolTip="Once a day, uploads your zones, levels, time, experience and kills. No names. Power leveling (more than 4 gains in 10 seconds) is left out."/>
                                    <Button Content="Delete my shared leveling" Command="{Binding DeleteMySharedLevelingCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,4"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,12" Text="{Binding LevelingShareSummary}"/>

                                <TextBlock FontWeight="SemiBold" Text="Mob stats"/>
                                <WrapPanel Margin="0,4,0,2">
                                    <CheckBox Content="Use everyone's mob stats" IsChecked="{Binding UseSharedMobStats}" Margin="0,0,18,4"
                                              ToolTip="Regen and HP, /con levels and resist rates from everyone, used when your own logs have none; and the Server Best column."/>
                                    <CheckBox Content="Share my mob stats" IsChecked="{Binding ShareMyMobStats}" Margin="0,0,18,4"
                                              ToolTip="Once a day: your kills (time, damage, attackers), /con levels by zone and resist counts. No names."/>
                                    <Button Content="Delete my shared mob stats" Command="{Binding DeleteMySharedMobStatsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,4"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,12" Text="{Binding MobStatsShareSummary}"/>

                                <TextBlock FontWeight="SemiBold" Text="Server First"/>
                                <WrapPanel Margin="0,4,0,2">
                                    <CheckBox Content="Share my raid fights for Server First (with names and guilds)" IsChecked="{Binding ShareServerFirsts}" Margin="0,0,18,4"
                                              ToolTip="Shares raid fights with more than 12 players on a named boss: the mob, kill time, length, and every player's name, guild, class, damage, healing and damage taken. You are asked before it turns on."/>
                                    <Button Content="Delete my Server First fights" Command="{Binding DeleteMySharedFirstsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,4"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,12" Text="{Binding FirstsShareSummary}"/>

                                <TextBlock FontWeight="SemiBold" Text="Player count"/>
                                <CheckBox Content="Count me in the anonymous player count" IsChecked="{Binding CountMeIn}" Margin="0,4,0,2"
                                          ToolTip="Once a day the app sends a random id and its version number, so we know how many people use EQ Overwatch. No names, no IP addresses, nothing else."/>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="Sends a random id and the app version once a day. Nothing else."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Updates">
                            <StackPanel Margin="4">
                                <CheckBox Content="Start with Windows (minimized)" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,6"
                                          ToolTip="Opens EQ Overwatch minimized when you sign in to Windows."/>
                                <CheckBox Content="Check for a newer version when the app opens" IsChecked="{Binding CheckForUpdates}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Check again while running every (hours)" VerticalAlignment="Center" Margin="0,0,8,0"
                                               ToolTip="How often the app looks for a newer version while it stays open. 0 checks only when the app opens."/>
                                    <TextBox Width="50" Text="{Binding UpdateCheckHours, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <WrapPanel>
                                    <Button Content="Check now" Command="{Binding CheckUpdatesNowCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"/>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource HintText}" Text="{Binding UpdateStatus}"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                    </presentation:ResponsiveColumnsPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
