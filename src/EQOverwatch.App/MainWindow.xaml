<Window x:Class="EQOverwatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:presentation="clr-namespace:EQOverwatch.App.Presentation"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/EQOverwatch.ico"
        Width="1220" Height="840"
        MinWidth="820" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="NumericCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Text that wraps onto more lines instead of being cut off. -->
        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="2,3"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DebuffsBarBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Green while live monitoring runs, muted otherwise. -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLiveRunning}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource BuffsBarBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Theme preset button: highlighted while its preset is the active one (Tag holds that flag). -->
        <Style x:Key="PresetPill" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The "shared trigger" approval bar: only visible while something is waiting for an answer. -->
        <Style x:Key="ApprovalBar" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasPendingSharedTriggers}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The "new version available" bar: only visible while there is an update to announce. -->
        <Style x:Key="UpdateBar" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A removable name chip. -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,3,4,3"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ═════════ Toolbar: name + version, monitoring, lock, mute, test ═════════ -->
        <Border DockPanel.Dock="Top" Margin="8,8,8,0" Padding="14,8" CornerRadius="10" BorderThickness="1"
                Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSoftBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0">
                    <TextBlock Text="{Binding AppName}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Margin="10,2,0,0" Padding="10,2" CornerRadius="11" VerticalAlignment="Center"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="{Binding AppVersion}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                    </Border>
                </StackPanel>

                <WrapPanel VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding LiveStatusText}" VerticalAlignment="Center" Margin="0,0,22,0"
                               Foreground="{DynamicResource TextMutedBrush}"/>

                    <ToggleButton Content="{Binding LockButtonText}" IsChecked="{Binding AreOverlaysLocked}" MinWidth="130" Margin="0,3,10,3"
                                  ToolTip="Locked overlays are click-through, so the mouse reaches EverQuest. Unlock to move and resize them."/>
                    <ToggleButton Content="Mute audio" IsChecked="{Binding IsAudioMuted}" Margin="0,3,10,3"
                                  ToolTip="Silences every spoken alert and sound."/>
                    <Button Content="Test overlays" Command="{Binding TestOverlaysCommand}" Style="{StaticResource SecondaryButton}" Margin="0,3,0,3"
                            ToolTip="Sends sample alerts, a bar for each timer overlay and a synthetic encounter."/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ═════════ A newer version has been published ═════════ -->
        <Border DockPanel.Dock="Top" Margin="8,8,8,0" Padding="14,10" CornerRadius="10" BorderThickness="1"
                Style="{StaticResource UpdateBar}"
                Background="{DynamicResource SelectedBgBrush}" BorderBrush="{DynamicResource AccentBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="Download" Margin="0,0,8,0" Command="{Binding OpenUpdateCommand}"/>
                    <Button Content="Later" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding DismissUpdateCommand}"/>
                    <Button Content="Skip this version" Style="{StaticResource SecondaryButton}" Command="{Binding SkipUpdateVersionCommand}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding UpdateMessage}"/>
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding UpdateNotes}" MaxHeight="64"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═════════ A trigger someone shared in chat is waiting for an answer ═════════ -->
        <Border DockPanel.Dock="Top" Margin="8,8,8,0" Padding="14,10" CornerRadius="10" BorderThickness="1"
                Style="{StaticResource ApprovalBar}"
                Background="{DynamicResource SelectedBgBrush}" BorderBrush="{DynamicResource AccentBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="Accept" Margin="0,0,8,0"
                            Command="{Binding AcceptSharedCommand}" CommandParameter="{Binding CurrentSharedOffer}"/>
                    <Button Content="Ignore" Style="{StaticResource SecondaryButton}"
                            Command="{Binding IgnoreSharedCommand}" CommandParameter="{Binding CurrentSharedOffer}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding CurrentSharedOffer.Title}"/>
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding CurrentSharedOffer.Detail}"/>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Nothing is turned on until you accept. Only accept triggers from people you trust. "/>
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding PendingSharedMore}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="8">

            <!-- ═════════ Tab 1: Characters ═════════ -->
            <TabItem Header="Characters">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Left" Content="Add log file…" Command="{Binding AddLogCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,14,0"
                                ToolTip="For a log that is not in your EverQuest Logs folder."/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding EqFolderStatus}"/>
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding ChainSummary}"/>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding SortedCharacters}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="Auto"/>
                            <DataGridTextColumn Header="Character" Binding="{Binding CharacterName}" Width="Auto" MinWidth="110"/>
                            <DataGridTextColumn Header="Level" Binding="{Binding LevelText, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Class" Binding="{Binding ClassText, Mode=OneWay}" Width="Auto"/>
                            <DataGridTemplateColumn Header="Character data" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Inventory" Style="{StaticResource SecondaryButton}" Margin="4,1" Padding="8,3"
                                                    ToolTip="Open this character's inventory (from /outputfile inventory)"
                                                    Command="{Binding DataContext.OpenInventoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Spellbook" Style="{StaticResource SecondaryButton}" Margin="0,1,4,1" Padding="8,3"
                                                    ToolTip="Open this character's spellbook (from /outputfile spellbook)"
                                                    Command="{Binding DataContext.OpenSpellbookCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Missing spells" Style="{StaticResource SecondaryButton}" Margin="0,1,4,1" Padding="8,3"
                                                    ToolTip="Open the spells this character has not scribed (from /outputfile missingspells)"
                                                    Command="{Binding DataContext.OpenMissingSpellsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Data from" Binding="{Binding DataText, Mode=OneWay}" Width="Auto"/>
                            <DataGridTemplateColumn Header="Enable Triggers" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsTriggerEnabled, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Primary DPS" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="PrimaryDps" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     IsChecked="{Binding IsPrimaryDps, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="CH Chain Position" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="6,2" MinWidth="110"
                                                  ItemsSource="{Binding DataContext.ChainPositionOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Display" SelectedValuePath="Value"
                                                  SelectedValue="{Binding ChChainPosition, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Style="{StaticResource SecondaryButton}" Margin="4,1" Padding="10,3"
                                                Command="{Binding DataContext.RemoveLogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GroupBox Grid.Row="2" Header="Additional characters to monitor (other PCs, groupmates)" Margin="0,10,0,0">
                        <StackPanel Margin="4">
                            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8"
                                       Text="Buffs landing on these characters start and reset timer bars here, just like your own characters. Strangers in the raid are ignored. Triggers only run on logs this PC can read."/>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="+ Add Character" Margin="10,0,0,0" Command="{Binding AddAdditionalCharacterCommand}"/>
                                <TextBox MaxLength="30" ToolTip="Character name, then Enter"
                                         Text="{Binding NewAdditionalCharacter, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding AddAdditionalCharacterCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding AdditionalCharacterRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                                      CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" HorizontalAlignment="Left" Width="620" MaxHeight="170">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Character" Binding="{Binding Name, Mode=OneWay}" Width="Auto"/>
                                    <DataGridTextColumn Header="Level" Binding="{Binding LevelText, Mode=OneWay}" Width="Auto"/>
                                    <DataGridTextColumn Header="Class" Binding="{Binding ClassText, Mode=OneWay}" Width="Auto"/>
                                    <DataGridTemplateColumn Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Remove" Style="{StaticResource SecondaryButton}" Margin="4,1" Padding="10,3"
                                                        ToolTip="Stop monitoring this character"
                                                        Command="{Binding DataContext.RemoveAdditionalCharacterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Name}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding AdditionalCharacterStatus}"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ═════════ Tab 2: Custom Triggers ═════════ -->
            <TabItem Header="Custom Triggers">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Master list -->
                    <DockPanel Grid.Column="0">
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="Add trigger" Command="{Binding AddRuleCommand}" Margin="0,0,8,6"/>
                            <Button Content="Remove" Command="{Binding RemoveRuleCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"/>
                            <Button Content="[ Share {EQO} ]" Command="{Binding ShareSelectedRuleCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6"
                                    ToolTip="Copies the selected trigger as an {EQO:...} token you can paste into raid chat."/>
                        </WrapPanel>
                        <ListBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DebuffsBarBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Detail editor -->
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding HasSelectedRule}">
                                <Grid Margin="0,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Setter Property="Margin" Value="0,3"/>
                                        </Style>
                                    </Grid.Resources>

                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Name"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                             Text="{Binding SelectedRule.Name, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Pattern"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" FontFamily="Consolas"
                                             Text="{Binding SelectedRule.Pattern, UpdateSourceTrigger=PropertyChanged}"/>

                                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,6">
                                        <CheckBox Content="Use regular expression" IsChecked="{Binding SelectedRule.UseRegex}" Margin="0,0,18,0"/>
                                        <CheckBox Content="Enabled" IsChecked="{Binding SelectedRule.IsEnabled}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ErrorText}"
                                               Text="{Binding SelectedRule.Error}"/>

                                    <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Timer (seconds)"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Width="90" HorizontalAlignment="Left"
                                             ToolTip="0 = no countdown bar"
                                             Text="{Binding SelectedRule.TimerDurationSeconds, UpdateSourceTrigger=LostFocus, StringFormat=0.##}"/>

                                    <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="Timer label"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                                             Text="{Binding SelectedRule.TimerLabelTemplate, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="Alert text"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                                             ToolTip="Leave empty for no flash alert"
                                             Text="{Binding SelectedRule.AlertTextTemplate, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="Speak (TTS)"/>
                                    <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2"
                                             ToolTip="Leave empty for no speech"
                                             Text="{Binding SelectedRule.AudioText, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" Text="Sound file (.wav)"/>
                                    <TextBox Grid.Row="8" Grid.Column="1"
                                             Text="{Binding SelectedRule.AudioFilePath, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Row="8" Grid.Column="2" Content="Browse…" Margin="8,3,0,3" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding PickWavCommand}"/>

                                    <TextBlock Grid.Row="9" Style="{StaticResource FieldLabel}" Text="Show in overlay"/>
                                    <ComboBox Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Width="200" HorizontalAlignment="Left" Margin="0,3"
                                              ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedRule.OverlayCategory}"/>

                                    <TextBlock Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,8" Style="{StaticResource HintText}"
                                               Text="Tokens: ${Character} (the character whose log matched), ${Trigger} (this trigger's name) and any regex group, e.g. ${caster}. Patterns are matched against the text after the timestamp."/>

                                    <TextBlock Grid.Row="11" Style="{StaticResource FieldLabel}" Text="Test line"/>
                                    <DockPanel Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2">
                                        <Button DockPanel.Dock="Right" Content="Test / Fire trigger" Margin="8,3,0,3"
                                                Command="{Binding FireSelectedRuleCommand}"/>
                                        <TextBox Text="{Binding TestLine, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="e.g. Ream begins to cast a spell. &lt;Complete Heal&gt;"/>
                                    </DockPanel>

                                    <TextBlock Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0"
                                               Style="{StaticResource HintText}" Text="{Binding TestResultText}"/>
                                </Grid>
                            </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ═════════ Tab 3: Raid Triggers ═════════ -->
            <TabItem Header="Raid Triggers">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Builder -->
                    <Border Grid.Row="0" Padding="12" Margin="0,0,0,10" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderSoftBrush}" Background="{DynamicResource WindowBgBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: which boss and which spell -->
                            <DockPanel Grid.Column="0">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Boss (mob)"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3" Style="{StaticResource SearchComboBox}" MaxDropDownHeight="300"
                                              ToolTip="Pick a mob you have fought, or type a new name. Leave empty to match any boss."
                                              ItemsSource="{Binding MobSuggestions}" TextSearch.TextPath="Name"
                                              Text="{Binding RaidMobName, UpdateSourceTrigger=PropertyChanged}"
                                              TextBoxBase.TextChanged="SearchCombo_TextChanged"
                                              PreviewTextInput="SearchCombo_UserInput" PreviewKeyDown="SearchCombo_UserInput">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0" Text="{Binding Detail}"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource HintText}" FontSize="11" Margin="0,0,0,2"
                                               Text="{Binding RaidMobHint}"/>
                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Search spell"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3"
                                             ToolTip="Searches every spell by name or id, including instant boss AEs"
                                             Text="{Binding RaidSpellSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintText}" Margin="0,0,0,6" Text="{Binding RaidSpellSearchStatus}"/>
                                <ListBox Height="150" ItemsSource="{Binding RaidSpellResults}" SelectedItem="{Binding SelectedRaidSpell, Mode=TwoWay}"
                                         DisplayMemberPath="Label"/>
                            </DockPanel>

                            <!-- Right: what to match, how often, where to show it -->
                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Margin" Value="0,3"/>
                                    </Style>
                                </Grid.Resources>

                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Spell name"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RaidSpellName, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Log text to match"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         ToolTip="Filled in with the casting line, for example &quot;begins to cast a spell. &lt;Dragon Roar&gt;&quot;. Case-sensitive; edit it if your log words it differently."
                                         Text="{Binding RaidMatchText, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Recast (seconds)"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                         Text="{Binding RaidRecastSeconds, UpdateSourceTrigger=LostFocus}"/>

                                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Show in overlay"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,3"
                                          ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding RaidCategory}"/>

                                <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Announce on start (TTS)"/>
                                <TextBox Grid.Row="4" Grid.Column="1"
                                         ToolTip="Optional. Spoken the moment the trigger starts. May use ${MobName} and ${SpellName}"
                                         Text="{Binding RaidStartTtsText, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="Announce at 10 s left (TTS)"/>
                                <TextBox Grid.Row="5" Grid.Column="1"
                                         ToolTip="Optional. Spoken when 10 seconds remain before the next cast (not used when the recast time is 10 seconds or less). May use ${MobName} and ${SpellName}"
                                         Text="{Binding RaidWarningTtsText, UpdateSourceTrigger=PropertyChanged}"/>

                                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Bottom">
                                    <Button Content="{Binding RaidSaveButtonText}" Command="{Binding AddRaidTriggerCommand}" Margin="0,0,10,0"/>
                                    <Button Content="Cancel edit" Command="{Binding CancelRaidEditCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                                    <Button Content="[ Share {EQO} ]" Command="{Binding ShareRaidBuilderCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,14,0"
                                            ToolTip="Copies this raid timer as an {EQO:...} token you can paste into raid chat."/>
                                    <TextBlock Text="{Binding RaidBuilderStatus}" Style="{StaticResource HintText}" VerticalAlignment="Center" MaxWidth="360"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Saved rules -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding RaidRules}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="On" Width="52">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Boss" Binding="{Binding MobText}" Width="140"/>
                            <DataGridTextColumn Header="Spell" Binding="{Binding SpellName}" Width="190"/>
                            <DataGridTextColumn Header="Log text" Binding="{Binding MatchText}" Width="*"/>
                            <DataGridTextColumn Header="Recast (s)" Binding="{Binding RecastSeconds}" Width="84" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Overlay" Binding="{Binding CategoryText}" Width="110"/>
                            <DataGridTextColumn Header="On start" Binding="{Binding StartText}" Width="130"/>
                            <DataGridTextColumn Header="At 10 s left" Binding="{Binding WarningText}" Width="130"/>
                            <DataGridTemplateColumn Width="300">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Edit" Style="{StaticResource SecondaryButton}" Margin="4,1" Padding="10,3"
                                                    Command="{Binding DataContext.EditRaidTriggerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="[ Share {EQO} ]" Style="{StaticResource SecondaryButton}" Margin="4,1" Padding="10,3"
                                                    Command="{Binding DataContext.ShareRaidRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Remove" Style="{StaticResource SecondaryButton}" Margin="4,1" Padding="10,3"
                                                    Command="{Binding DataContext.RemoveRaidTriggerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ═════════ Tab 4: Spells & Songs ═════════ -->
            <TabItem Header="Spells &amp; Songs">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource HintText}" Margin="0,0,0,10" Text="{Binding SpellsStatus}"/>

                    <!-- Track a buff, debuff or song -->
                    <Border Grid.Row="1" Padding="12" Margin="0,0,0,12" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderSoftBrush}" Background="{DynamicResource WindowBgBrush}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Track a buff, debuff or song"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Spell (type to search)"/>
                                    <ComboBox Style="{StaticResource SearchComboBox}" MaxDropDownHeight="320"
                                              ItemsSource="{Binding TrackerSuggestions}"
                                              SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}"
                                              Text="{Binding TrackerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                              TextSearch.TextPath="Name"
                                              TextBoxBase.TextChanged="SearchCombo_TextChanged"
                                              PreviewTextInput="SearchCombo_UserInput" PreviewKeyDown="SearchCombo_UserInput">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0" Text="{Binding Detail}"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Show on overlay"/>
                                    <ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                              SelectedValue="{Binding TrackerOverlay}"/>
                                </StackPanel>

                                <Button Grid.Column="4" Content="Add to Tracker" VerticalAlignment="Bottom"
                                        Command="{Binding AddTrackedSpellCommand}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" Text="{Binding TrackerPreview}"/>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="{Binding TrackerStatus}"/>
                        </StackPanel>
                    </Border>

                    <!-- List header: summary, filter and the activity line -->
                    <DockPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBox DockPanel.Dock="Right" Width="240" Margin="14,0,0,0"
                                 ToolTip="Filters your list by spell name, landing text or overlay"
                                 Text="{Binding TrackedFilterText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"
                                   Text="{Binding TrackedSummary}"/>
                        <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Text="{Binding TrackerActivity}"/>
                    </DockPanel>

                    <!-- Tracked spells -->
                    <DataGrid Grid.Row="3" ItemsSource="{Binding VisibleTrackedSpells}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="On" Width="52">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Spell" Binding="{Binding Name}" Width="170" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="ID" Binding="{Binding SpellId}" Width="64" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="80" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTemplateColumn Header="Overlay" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="4,2" MinHeight="26"
                                                  ItemsSource="{Binding DataContext.CategoryOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Display" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Overlay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Starts when" Binding="{Binding StartsWhen, Mode=OneWay}" Width="*" MinWidth="110" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Cast on you" Binding="{Binding CastOnYou}" Width="*" MinWidth="110" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Cast on other" Binding="{Binding CastOnOther}" Width="*" MinWidth="110" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Fades" Binding="{Binding SpellFades}" Width="*" MinWidth="110" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTemplateColumn Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Style="{StaticResource SecondaryButton}" Margin="4,1" Padding="10,3"
                                                Command="{Binding DataContext.RemoveTrackedSpellCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ═════════ Tab: AAs & Discs ═════════ -->
            <TabItem Header="AAs &amp; Discs">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource HintText}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="Each time a tracked AA or discipline is used, an &quot;active&quot; bar (how long it lasts) and a &quot;cooldown&quot; bar (until it can be used again) start for the person who used it. One person using it again only restarts their own bars. Choose per ability whether to see everyone in the raid or only the characters you are monitoring, and which overlay each bar appears in."/>

                    <!-- Track an AA or discipline -->
                    <Border Grid.Row="1" Padding="12" Margin="0,0,0,12" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderSoftBrush}" Background="{DynamicResource WindowBgBrush}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Track an AA or discipline"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="190"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Ability (type to search, or type a name in full)"/>
                                    <ComboBox Style="{StaticResource SearchComboBox}" MaxDropDownHeight="320"
                                              ItemsSource="{Binding AbilitySuggestions}"
                                              SelectedItem="{Binding SelectedAbilitySuggestion, Mode=TwoWay}"
                                              Text="{Binding AbilitySearchText, UpdateSourceTrigger=PropertyChanged}"
                                              TextSearch.TextPath="Name"
                                              TextBoxBase.TextChanged="SearchCombo_TextChanged"
                                              PreviewTextInput="SearchCombo_UserInput" PreviewKeyDown="SearchCombo_UserInput">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0" Text="{Binding Detail}"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Lasts" ToolTip="How long the ability lasts, e.g. 3:00. Blank = no active bar."/>
                                    <TextBox Text="{Binding AbilityActiveText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Cooldown" ToolTip="How long until it can be used again, e.g. 10:30. Blank = no cooldown bar."/>
                                    <TextBox Text="{Binding AbilityCooldownText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Whose use to show"/>
                                    <ComboBox ItemsSource="{Binding ScopeOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                              SelectedValue="{Binding AbilityScope}"/>
                                </StackPanel>
                            </Grid>

                            <WrapPanel Margin="0,10,0,0">
                                <StackPanel Margin="0,0,14,0" Width="190">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Active bar overlay"/>
                                    <ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                              SelectedValue="{Binding AbilityActiveOverlay}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0" Width="190">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Cooldown bar overlay"/>
                                    <ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                              SelectedValue="{Binding AbilityCooldownOverlay}"/>
                                </StackPanel>
                                <Button Content="Add to Tracker" VerticalAlignment="Bottom" Command="{Binding AddAbilityCommand}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" Text="{Binding AbilityStatus}"/>
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"
                                   Text="{Binding AbilitySummary}"/>
                        <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Text="{Binding AbilityActivity}"/>
                    </DockPanel>

                    <!-- Tracked abilities -->
                    <DataGrid Grid.Row="3" ItemsSource="{Binding TrackedAbilities}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="On" Width="52">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Ability" Binding="{Binding Name}" Width="150" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTemplateColumn Header="Lasts" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Margin="4,2" MinHeight="26" Text="{Binding ActiveText, UpdateSourceTrigger=LostFocus}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Active overlay" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="4,2" MinHeight="26"
                                                  ItemsSource="{Binding DataContext.CategoryOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Display" SelectedValuePath="Value"
                                                  SelectedValue="{Binding ActiveOverlay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Cooldown" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Margin="4,2" MinHeight="26" Text="{Binding CooldownText, UpdateSourceTrigger=LostFocus}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Cooldown overlay" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="4,2" MinHeight="26"
                                                  ItemsSource="{Binding DataContext.CategoryOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Display" SelectedValuePath="Value"
                                                  SelectedValue="{Binding CooldownOverlay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Whose use" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="4,2" MinHeight="26"
                                                  ItemsSource="{Binding DataContext.ScopeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Display" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Scope, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Starts when" Binding="{Binding StartsWhen, Mode=OneWay}" Width="*" MinWidth="130" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Fades" Binding="{Binding FadesText, Mode=OneWay}" Width="*" MinWidth="120" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTemplateColumn Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Style="{StaticResource SecondaryButton}" Margin="4,1" Padding="10,3"
                                                Command="{Binding DataContext.RemoveAbilityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Class cooldown tracker -->
                    <GroupBox Grid.Row="4" Header="Built-in: Divine Aura" Margin="0,10,0,0">
                        <StackPanel Margin="4">
                            <CheckBox Content="Track class cooldowns (starts a bar when the ability is used)"
                                      IsChecked="{Binding IsCooldownTrackerEnabled}" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6"
                                       Text="The Cleric Divine Aura spell and the two Divine Aura AAs all end with &quot;A divine aura surrounds you.&quot;; the line before it tells them apart. Bars appear in the Raid Triggers overlay. Divine Aura needs this built-in tracker because its three versions share one landing message."/>
                            <ItemsControl ItemsSource="{Binding CooldownRules}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock DockPanel.Dock="Left" Width="300" FontWeight="SemiBold" Text="{Binding Label}"/>
                                            <TextBlock DockPanel.Dock="Left" Width="70" Text="{Binding CooldownText}" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Style="{StaticResource HintText}" Text="{Binding Detection}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ═════════ Tab 5: DPS & Encounter History ═════════ -->
            <TabItem Header="Encounter DPS">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Source selector + exports -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <WrapPanel HorizontalAlignment="Left">
                            <Button Content="[ Copy Top 12 for EQ Chat ]" Command="{Binding CopyTop12ForChatCommand}" Margin="0,0,8,0"
                                    ToolTip="Copies the selected fight and its top 12 attackers as text for EverQuest chat."/>
                            <Button Content="[ Copy Image for Discord ]" Command="{Binding CopyImageForDiscordCommand}"
                                    ToolTip="Copies the selected fight as one picture with the damage dealt and the damage taken, ready to paste into Discord."/>
                        </WrapPanel>
                    </DockPanel>

                    <!-- The Primary DPS log loads by itself; this line only reports on it. -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource HintText}" Text="{Binding ImportStatus}"/>
                        <ProgressBar Width="200" Height="8" Margin="12,0,0,0" Minimum="0" Maximum="100" Value="{Binding ImportProgress}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsImporting}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </StackPanel>

                    <!-- Encounter browser + participant breakdown -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0" ItemsSource="{Binding Encounters}" SelectedItem="{Binding SelectedEncounter, Mode=TwoWay}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Target" Binding="{Binding TargetName}" Width="*" MinWidth="120"/>
                                <DataGridTextColumn Header="Start" Binding="{Binding StartText}" SortMemberPath="StartTime" Width="140"/>
                                <DataGridTextColumn Header="Length" Binding="{Binding DurationText}" SortMemberPath="DurationSeconds" Width="64"
                                                    ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Damage" Binding="{Binding TotalDamage, StringFormat=N0}" Width="84"
                                                    ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Group DPS" Binding="{Binding GroupDps, StringFormat=N0}" Width="80"
                                                    ElementStyle="{StaticResource NumericCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Right half: damage dealt on top, damage taken below. -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"
                                           Text="{Binding EncounterSummary}"/>
                                <DataGrid ItemsSource="{Binding Participants}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          FrozenColumnCount="2" HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Name" Binding="{Binding DisplayName, Mode=OneWay}" Width="Auto"/>
                                        <DataGridTextColumn Header="Class" Binding="{Binding Class}" Width="Auto"/>
                                        <DataGridTemplateColumn Header="Total damage" Width="170" SortMemberPath="TotalDamage">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding BarFraction, Mode=OneWay}" Height="16"
                                                                     BorderThickness="0" Background="Transparent"
                                                                     Foreground="{DynamicResource AccentBrush}" Opacity="0.45"/>
                                                        <TextBlock Text="{Binding TotalDamage, StringFormat=N0}" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="% of group" Binding="{Binding DamagePercent, StringFormat={}{0:0.0}%}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Scaled DPS" Binding="{Binding ScaledDps, StringFormat=N1}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="DPS" Binding="{Binding Dps, StringFormat=N1}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Max hit" Binding="{Binding MaxHit, StringFormat=N0}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Max crit" Binding="{Binding MaxCritHit, StringFormat=N0}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Hits" Binding="{Binding Hits, StringFormat=N0}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Misses" Binding="{Binding Misses, StringFormat=N0}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Hit rate" Binding="{Binding HitRatePercent, StringFormat={}{0:0.0}%}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Crit %" Binding="{Binding CritRatePercent, StringFormat={}{0:0.0}%}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <DockPanel Grid.Row="2">
                                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"
                                           Text="{Binding DamageTakenSummary}"/>
                                <DataGrid ItemsSource="{Binding DamageTaken}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          FrozenColumnCount="2" HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Name" Binding="{Binding DisplayName, Mode=OneWay}" Width="Auto"/>
                                        <DataGridTemplateColumn Header="Damage taken" Width="170" SortMemberPath="TotalDamage">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding BarFraction, Mode=OneWay}" Height="16"
                                                                     BorderThickness="0" Background="Transparent" Foreground="#E5845C" Opacity="0.55"/>
                                                        <TextBlock Text="{Binding TotalDamage, StringFormat=N0}" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="% of total" Binding="{Binding PercentOfTotal, StringFormat={}{0:0.0}%}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Hits" Binding="{Binding Hits, StringFormat=N0}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Max hit" Binding="{Binding MaxHit, StringFormat=N0}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═════════ Tab 6: Settings ═════════ -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <presentation:ResponsiveColumnsPanel Margin="6,6,14,6" MinColumnWidth="430" MaxColumns="3" ColumnGap="12">

                        <GroupBox Header="EverQuest game folder">
                            <StackPanel Margin="4">
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="↻ Refresh" Command="{Binding RefreshEqFolderCommand}"
                                            Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                                            ToolTip="Looks for new character logs and reloads spells_us.txt."/>
                                    <Button DockPanel.Dock="Left" Content="Set EverQuest Folder…" Command="{Binding SetEqFolderCommand}" Margin="0,0,10,0"/>
                                    <TextBox IsReadOnly="True" VerticalAlignment="Center" Text="{Binding EqFolderPath, Mode=OneWay}"/>
                                </DockPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Default Caster Level"/>
                                    <TextBox Width="56" VerticalAlignment="Center"
                                             ToolTip="Durations are calculated for this caster level (focus and AA extensions are not included)."
                                             Text="{Binding DefaultCasterLevel, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Text="1-125" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,24,0"/>
                                    <Button Content="Choose spell file…" Command="{Binding BrowseSpellsCommand}" Style="{StaticResource SecondaryButton}"
                                            ToolTip="Only needed if spells_us.txt is not in the EverQuest folder."/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource HintText}" Text="{Binding EqFolderStatus}"/>
                                <TextBlock Style="{StaticResource HintText}" Text="{Binding SpellsStatus}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Overlay windows">
                            <StackPanel Margin="4">
                                <WrapPanel>
                                    <CheckBox Content="Buffs" IsChecked="{Binding IsBuffsOverlayVisible}" Margin="0,0,20,6"/>
                                    <CheckBox Content="Debuffs" IsChecked="{Binding IsDebuffsOverlayVisible}" Margin="0,0,20,6"/>
                                    <CheckBox Content="Songs" IsChecked="{Binding IsSongsOverlayVisible}" Margin="0,0,20,6"/>
                                    <CheckBox Content="Raid Triggers" IsChecked="{Binding IsRaidTriggersOverlayVisible}" Margin="0,0,20,6"/>
                                    <CheckBox Content="CH Chain" IsChecked="{Binding IsChChainOverlayVisible}" Margin="0,0,20,6"/>
                                    <CheckBox Content="DPS" IsChecked="{Binding IsDpsOverlayVisible}" Margin="0,0,20,6"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="With the CH Chain overlay off, Complete Heal chain bars and the late-cast alarm are shown in the Buffs overlay instead."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Historical fights &amp; DPS">
                            <StackPanel Margin="4">
                                <WrapPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Historical Days to Load"/>
                                    <ComboBox Width="140" Margin="0,0,28,6"
                                              ItemsSource="{Binding HistoricalDaysOptions}" DisplayMemberPath="Display" SelectedValuePath="Days"
                                              SelectedValue="{Binding HistoricalDaysLimit}"/>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Encounter Timeout Seconds"
                                               ToolTip="An encounter ends after this many log seconds without activity. Applies to new events; reload history to re-split old fights."/>
                                    <TextBox Width="64" VerticalAlignment="Center" Margin="0,0,0,6"
                                             Text="{Binding EncounterTimeoutSeconds, UpdateSourceTrigger=LostFocus, StringFormat=0.##}"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="When the app opens it loads the Primary DPS character's recent log into the DPS meter, so a fight already in progress shows as if the app had been open all along. All fights, live and imported, share one list on the DPS tab, newest first."/>
                                <TextBlock Style="{StaticResource HintText}" Text="{Binding ImportStatus}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Cleric CH chain">
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Margin" Value="0,3"/>
                                    </Style>
                                </Grid.Resources>

                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Position Tag Format"/>
                                <TextBox Grid.Row="0" Grid.Column="1" FontFamily="Consolas"
                                         ToolTip="Each {N} is the cleric's position: {N}-{N}-{N} gives 3-3-3"
                                         Text="{Binding ChainPositionTagFormat, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource ErrorText}"
                                           Text="{Binding ChainTagError}"/>

                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Cue Statement / Keyword"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ChainCueKeyword, UpdateSourceTrigger=PropertyChanged}"/>


                                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Late Cast Alert Threshold Seconds"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                         Text="{Binding ChainLateThresholdSeconds, UpdateSourceTrigger=LostFocus, StringFormat=0.##}"/>

                                <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource HintText}" Margin="0,8,0,0"
                                           Text="When another cleric says your position tag together with the cue (for example &quot;3-3-3 CAST NOW!&quot;; any letter case) and you have not begun casting Complete Heal within the threshold, a flashing &quot;CAST CH NOW!&quot; banner and a spoken alarm repeat every second until you do. Pick your position on the Characters tab."/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Theme &amp; colors">
                            <StackPanel Margin="4">
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="Obsidian Slate" Style="{StaticResource PresetPill}" Margin="0,0,8,4"
                                            Command="{Binding SelectThemePresetCommand}" CommandParameter="ObsidianSlate"
                                            Tag="{Binding IsObsidianSlateSelected}"/>
                                    <Button Content="Velious Frost" Style="{StaticResource PresetPill}" Margin="0,0,8,4"
                                            Command="{Binding SelectThemePresetCommand}" CommandParameter="VeliousFrost"
                                            Tag="{Binding IsVeliousFrostSelected}"/>
                                    <Button Content="Kunark Ember" Style="{StaticResource PresetPill}" Margin="0,0,8,4"
                                            Command="{Binding SelectThemePresetCommand}" CommandParameter="KunarkEmber"
                                            Tag="{Binding IsKunarkEmberSelected}"/>
                                    <Button Content="Custom" Style="{StaticResource PresetPill}" Margin="0,0,8,4"
                                            Command="{Binding SelectThemePresetCommand}" CommandParameter="Custom"
                                            Tag="{Binding IsCustomThemeSelected}"/>
                                    <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="8,0,0,4"
                                               Text="Type a hex color (#RRGGBB) to start a custom theme. It applies to every window straight away."/>
                                </WrapPanel>

                <ItemsControl ItemsSource="{Binding ThemeColors}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,6">
                                <Border Width="24" Height="24" CornerRadius="7" BorderThickness="1" Margin="0,0,8,0"
                                        Background="{Binding Hex}" BorderBrush="{DynamicResource BorderSoftBrush}"/>
                                <TextBlock Text="{Binding Label}" Width="118" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBox Width="96" FontFamily="Consolas" Text="{Binding HexText, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DebuffsBarBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                            </StackPanel>
                        </GroupBox>


                        <GroupBox Header="Players &amp; pets">
                            <StackPanel Margin="4">
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource HintText}" Margin="0,0,0,6"
                                           Text="Classes come from /who. To link a pet to its owner, target the pet and type /pet leader; the pet answers &quot;My leader is Name.&quot; and the app remembers it."/>
                                <CheckBox Content="Count a pet's damage under its owner" IsChecked="{Binding MergePetDamage}" Margin="0,0,0,6"
                                          ToolTip="Applies to fights parsed from now on. Off lists each pet on its own row."/>
                                <TextBlock Text="{Binding RosterSummary}" Style="{StaticResource HintText}" Margin="0,0,0,6"/>
                                <StackPanel>
                                    <DataGrid Height="150" ItemsSource="{Binding RosterPlayers}" AutoGenerateColumns="False"
                                              CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="Level" Binding="{Binding LevelText, Mode=OneWay}" Width="56"/>
                                            <DataGridTextColumn Header="Class" Binding="{Binding Class}" Width="110"/>
                                            <DataGridTemplateColumn Width="70">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Forget" Style="{StaticResource SecondaryButton}"
                                                                Command="{Binding DataContext.ForgetPlayerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <DataGrid Height="120" Margin="0,8,0,0" ItemsSource="{Binding RosterPets}" AutoGenerateColumns="False"
                                              CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Pet" Binding="{Binding Pet}" Width="*"/>
                                            <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="*"/>
                                            <DataGridTemplateColumn Width="70">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Forget" Style="{StaticResource SecondaryButton}"
                                                                Command="{Binding DataContext.ForgetPetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                                <Button Content="Forget everyone" Command="{Binding ClearRosterCommand}" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Updates">
                            <StackPanel Margin="4">
                                <CheckBox Content="Check for a newer version when the app opens" IsChecked="{Binding CheckForUpdates}" Margin="0,0,0,6"/>
                                <WrapPanel>
                                    <Button Content="Check now" Command="{Binding CheckUpdatesNowCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"/>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource HintText}" Text="{Binding UpdateStatus}"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                    </presentation:ResponsiveColumnsPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
