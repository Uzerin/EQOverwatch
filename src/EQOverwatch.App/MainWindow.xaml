<Window x:Class="EQOverwatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:presentation="clr-namespace:EQOverwatch.App.Presentation"
        xmlns:ctl="clr-namespace:EQOverwatch.App.Controls"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/EQOverwatch.ico"
        Width="1220" Height="840"
        MinWidth="820" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="NumericCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Text that wraps onto more lines instead of being cut off. -->
        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="2,3"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DebuffsBarBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Green while live monitoring runs, muted otherwise. -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLiveRunning}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource BuffsBarBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Theme preset button: highlighted while its preset is the active one (Tag holds that flag). -->
        <Style x:Key="PresetPill" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The "shared trigger" approval bar: only visible while something is waiting for an answer. -->
        <Style x:Key="ApprovalBar" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasPendingSharedTriggers}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The "new version available" bar: only visible while there is an update to announce. -->
        <Style x:Key="UpdateBar" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The top bar's Overwatch Discord button, in Discord's own blue. -->
        <Style x:Key="DiscordButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#5865F2"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#4752C4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3C45A5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A removable name chip. -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,3,4,3"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ═════════ Toolbar: name + version, monitoring, lock, mute, test ═════════ -->
        <Border DockPanel.Dock="Top" Margin="8,8,8,0" Padding="14,8" CornerRadius="10" BorderThickness="1"
                Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSoftBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0">
                    <TextBlock Text="{Binding AppName}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Margin="10,2,0,0" Padding="10,2" CornerRadius="11" VerticalAlignment="Center"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="{Binding AppVersion}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                    </Border>
                </StackPanel>

                <Button DockPanel.Dock="Right" Style="{StaticResource DiscordButton}" Command="{Binding OpenDiscordCommand}" VerticalAlignment="Center"
                        Margin="14,3,0,3" ToolTip="Join the EQ Overwatch Discord server: news, help and ideas.">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="18" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Fill="White" Data="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"/>
                        </Viewbox>
                        <TextBlock Text="Overwatch Discord" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <WrapPanel VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding LiveStatusText}" VerticalAlignment="Center" Margin="0,0,14,0"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0" Background="Transparent"
                                ToolTip="{Binding SharingLightTip}">
                        <Ellipse Width="9" Height="9" Fill="{Binding SharingLightColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Sharing" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>

                    <ToggleButton Content="{Binding LockButtonText}" IsChecked="{Binding AreOverlaysLocked}" MinWidth="130" Margin="0,3,10,3"
                                  ToolTip="Locked overlays are click-through, so the mouse reaches EverQuest. Unlock to move and resize them."/>
                    <ToggleButton Content="Mute audio" IsChecked="{Binding IsAudioMuted}" Margin="0,3,10,3"
                                  ToolTip="Silences every spoken alert and sound."/>
                    <TextBlock Text="Server" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextMutedBrush}"/>
                    <ComboBox Width="150" Margin="0,3,14,3" ItemsSource="{Binding ToolsServers}" SelectedItem="{Binding SelectedToolsServer, Mode=TwoWay}"
                              ToolTip="Filters the Characters, Loot, Attendance, Items &amp; Scrolls and Mob History tabs and the DPS tab's fights. Starts on the server of the character you played last; pick another server, or All servers."/>
                    <Button Content="Test overlays" Command="{Binding TestOverlaysCommand}" Style="{StaticResource SecondaryButton}" Margin="0,3,0,3"
                            ToolTip="Sends sample alerts, a bar for each timer overlay and a synthetic encounter."/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ═════════ A newer version has been published ═════════ -->
        <Border DockPanel.Dock="Top" Margin="8,8,8,0" Padding="14,10" CornerRadius="10" BorderThickness="1"
                Style="{StaticResource UpdateBar}"
                Background="{DynamicResource SelectedBgBrush}" BorderBrush="{DynamicResource AccentBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="Install update" Margin="0,0,8,0" Command="{Binding InstallUpdateCommand}"
                            ToolTip="Downloads the new version, checks it against its published checksum, replaces EQOverwatch.exe and restarts. Not available during combat.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateCanInstall}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Release page" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding OpenUpdateCommand}"/>
                    <Button Content="Later" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Command="{Binding DismissUpdateCommand}"/>
                    <Button Content="Skip this version" Style="{StaticResource SecondaryButton}" Command="{Binding SkipUpdateVersionCommand}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding UpdateMessage}"/>
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding UpdateInstallHint}"/>
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding UpdateNotes}" MaxHeight="64"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═════════ A trigger someone shared in chat is waiting for an answer ═════════ -->
        <Border DockPanel.Dock="Top" Margin="8,8,8,0" Padding="14,10" CornerRadius="10" BorderThickness="1"
                Style="{StaticResource ApprovalBar}"
                Background="{DynamicResource SelectedBgBrush}" BorderBrush="{DynamicResource AccentBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="Accept" Margin="0,0,8,0"
                            Command="{Binding AcceptSharedCommand}" CommandParameter="{Binding CurrentSharedOffer}"/>
                    <Button Content="Ignore" Style="{StaticResource SecondaryButton}"
                            Command="{Binding IgnoreSharedCommand}" CommandParameter="{Binding CurrentSharedOffer}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding CurrentSharedOffer.Title}"/>
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding CurrentSharedOffer.Detail}"/>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Nothing is turned on until you accept. Only accept triggers from people you trust. "/>
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding PendingSharedMore}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="8" SelectedIndex="{Binding SelectedMainTab, Mode=TwoWay}">

            <!-- ═════════ Tab 1: Characters ═════════ -->
            <TabItem Header="Characters">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Left" Content="Add log file…" Command="{Binding AddLogCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,14,0"
                                ToolTip="For a log that is not in your EverQuest Logs folder."/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding EqFolderStatus}"/>
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding ChainSummary}"/>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding SortedCharacters}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="Auto"/>
                            <DataGridTemplateColumn Header="Account" Width="Auto" SortMemberPath="AccountText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AccountText}" VerticalAlignment="Center" Margin="4,0"
                                                   ToolTip="Set in the character's Profile window. Colors are in the Colors window.">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasAccountColor}" Value="True">
                                                            <Setter Property="Foreground" Value="{Binding AccountColor}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Guild" Binding="{Binding GuildText}" Width="Auto"/>
                            <DataGridTemplateColumn Header="Character" Width="Auto" MinWidth="110" SortMemberPath="CharacterName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="#3CC85A" VerticalAlignment="Center"
                                                     ToolTip="Logged in: its log had a line in the last minute">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActiveNow}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding CharacterName}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Level" Binding="{Binding LevelText, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Class" Binding="{Binding ClassText, Mode=OneWay}" Width="Auto"/>
                            <DataGridTemplateColumn Header="Character data" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Inventory / Profile" Style="{StaticResource SecondaryButton}" Margin="4,1" Padding="8,3"
                                                ToolTip="Open this character's window: inventory, spellbook, missing spells, key ring, focus effects, skills, tradeskills and faction"
                                                Command="{Binding DataContext.OpenProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Data from" Binding="{Binding DataText, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Played" Binding="{Binding PlayedText, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedText, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Account Last Played" Binding="{Binding AccountPlayedText, Mode=OneWay}" Width="Auto"/>
                            <DataGridTemplateColumn Header="Enable Triggers" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsTriggerEnabled, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="Tank" ToolTip="No aggro alert when a mob attacks a tank. Warriors, paladins and shadow knights start ticked."/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsTank, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="CH Chain Position" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="6,2" MinWidth="110"
                                                  ItemsSource="{Binding DataContext.ChainPositionOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Display" SelectedValuePath="Value"
                                                  SelectedValue="{Binding ChChainPosition, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Style="{StaticResource SecondaryButton}" Margin="4,1" Padding="10,3"
                                                Command="{Binding DataContext.RemoveLogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GroupBox Grid.Row="2" Header="Additional characters to monitor (other PCs, groupmates)" Margin="0,10,0,0">
                        <StackPanel Margin="4">
                            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8"
                                       Text="Buffs landing on these characters start and reset timer bars here, just like your own characters. Strangers in the raid are ignored. Triggers only run on logs this PC can read."/>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="+ Add Character" Margin="10,0,0,0" Command="{Binding AddAdditionalCharacterCommand}"/>
                                <ComboBox DockPanel.Dock="Right" Width="150" Margin="10,0,0,0" ToolTip="The server this character plays on"
                                          ItemsSource="{Binding ServerChoices}"
                                          SelectedItem="{Binding NewAdditionalCharacterServer, Mode=TwoWay}"/>
                                <TextBox MaxLength="30" ToolTip="Character name, then Enter"
                                         Text="{Binding NewAdditionalCharacter, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding AddAdditionalCharacterCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding AdditionalCharacterRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                                      CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" HorizontalAlignment="Left" Width="620" MaxHeight="170">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Character" Binding="{Binding Name, Mode=OneWay}" Width="Auto"/>
                                    <DataGridTemplateColumn Header="Server" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Margin="2,1" ToolTip="Change the server this character is tracked on"
                                                          ItemsSource="{Binding DataContext.ServerChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding Server, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Level" Binding="{Binding LevelText, Mode=OneWay}" Width="Auto"/>
                                    <DataGridTextColumn Header="Class" Binding="{Binding ClassText, Mode=OneWay}" Width="Auto"/>
                                    <DataGridTemplateColumn Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Remove" Style="{StaticResource SecondaryButton}" Margin="4,1" Padding="10,3"
                                                        ToolTip="Stop monitoring this character"
                                                        Command="{Binding DataContext.RemoveAdditionalCharacterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding AdditionalCharacterStatus}"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ═════════ Tab 2: Custom Triggers ═════════ -->
            <TabItem Header="Custom Triggers">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Master list -->
                    <DockPanel Grid.Column="0">
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="Add trigger" Command="{Binding AddRuleCommand}" Margin="0,0,8,6"/>
                            <Button Content="Remove" Command="{Binding RemoveRuleCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"/>
                            <Button Content="[ Share {EQO} ]" Command="{Binding ShareSelectedRuleCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6"
                                    ToolTip="Copies the selected trigger as an {EQO:...} token you can paste into raid chat."/>
                        </WrapPanel>
                        <ListBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DebuffsBarBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Detail editor -->
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding HasSelectedRule}">
                                <Grid Margin="0,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Setter Property="Margin" Value="0,3"/>
                                        </Style>
                                    </Grid.Resources>

                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Name"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                             Text="{Binding SelectedRule.Name, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Pattern"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" FontFamily="Consolas"
                                             Text="{Binding SelectedRule.Pattern, UpdateSourceTrigger=PropertyChanged}"/>

                                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,6">
                                        <CheckBox Content="Use regular expression" IsChecked="{Binding SelectedRule.UseRegex}" Margin="0,0,18,0"/>
                                        <CheckBox Content="Enabled" IsChecked="{Binding SelectedRule.IsEnabled}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ErrorText}"
                                               Text="{Binding SelectedRule.Error}"/>

                                    <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Timer (seconds)"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Width="90" HorizontalAlignment="Left"
                                             ToolTip="0 = no countdown bar"
                                             Text="{Binding SelectedRule.TimerDurationSeconds, UpdateSourceTrigger=LostFocus, StringFormat=0.##}"/>

                                    <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="Timer label"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                                             Text="{Binding SelectedRule.TimerLabelTemplate, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="Alert text"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                                             ToolTip="Leave empty for no flash alert"
                                             Text="{Binding SelectedRule.AlertTextTemplate, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="Speak (TTS)"/>
                                    <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2"
                                             ToolTip="Leave empty for no speech"
                                             Text="{Binding SelectedRule.AudioText, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" Text="Sound file (.wav)"/>
                                    <TextBox Grid.Row="8" Grid.Column="1"
                                             Text="{Binding SelectedRule.AudioFilePath, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Row="8" Grid.Column="2" Content="Browse…" Margin="8,3,0,3" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding PickWavCommand}"/>

                                    <TextBlock Grid.Row="9" Style="{StaticResource FieldLabel}" Text="Show in overlay"/>
                                    <ComboBox Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Width="200" HorizontalAlignment="Left" Margin="0,3"
                                              ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedRule.OverlayCategory}"/>

                                    <TextBlock Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,8" Style="{StaticResource HintText}"
                                               Text="Tokens: ${Character} (the character whose log matched), ${Trigger} (this trigger's name) and any regex group, e.g. ${caster}. Patterns are matched against the text after the timestamp."/>

                                    <TextBlock Grid.Row="11" Style="{StaticResource FieldLabel}" Text="Test line"/>
                                    <DockPanel Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2">
                                        <Button DockPanel.Dock="Right" Content="Test / Fire trigger" Margin="8,3,0,3"
                                                Command="{Binding FireSelectedRuleCommand}"/>
                                        <TextBox Text="{Binding TestLine, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="e.g. Ream begins to cast a spell. &lt;Complete Heal&gt;"/>
                                    </DockPanel>

                                    <TextBlock Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0"
                                               Style="{StaticResource HintText}" Text="{Binding TestResultText}"/>
                                </Grid>
                            </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ═════════ Tab 3: Raid Triggers ═════════ -->
            <TabItem Header="Raid Triggers">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Builder -->
                    <Border Grid.Row="0" Padding="12" Margin="0,0,0,10" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderSoftBrush}" Background="{DynamicResource WindowBgBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: which boss and which spell -->
                            <DockPanel Grid.Column="0">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Boss (mob)"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3" Style="{StaticResource SearchComboBox}" MaxDropDownHeight="300"
                                              ToolTip="Pick a mob you have fought, or type a new name. Leave empty to match any boss."
                                              ItemsSource="{Binding MobSuggestions}" TextSearch.TextPath="Name"
                                              Text="{Binding RaidMobName, UpdateSourceTrigger=PropertyChanged}"
                                              TextBoxBase.TextChanged="SearchCombo_TextChanged"
                                              PreviewTextInput="SearchCombo_UserInput" PreviewKeyDown="SearchCombo_UserInput">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0" Text="{Binding Detail}"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Row="0" Grid.Column="2" Margin="8,3,0,3" Content="Recommended…" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding SuggestRaidTriggersCommand}"
                                            ToolTip="Looks through the fights against this boss for spells cast again and again at about the same interval, and offers them as raid triggers."/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource HintText}" FontSize="11" Margin="0,0,0,2"
                                               Text="{Binding RaidMobHint}"/>
                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Search spell"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3"
                                             ToolTip="Searches every spell by name or id, including instant boss AEs"
                                             Text="{Binding RaidSpellSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8" CornerRadius="6" BorderThickness="1"
                                        BorderBrush="{DynamicResource BorderSoftBrush}" Background="{DynamicResource CardBgBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRecommendationPanel}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Content="Add all" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding AddAllRecommendedTriggersCommand}"/>
                                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                       Text="{Binding RecommendedStatus}"/>
                                        </DockPanel>
                                        <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding RecommendedTriggers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,2">
                                                            <Button DockPanel.Dock="Right" Content="{Binding ButtonText}" MinWidth="64"
                                                                    Style="{StaticResource SecondaryButton}"
                                                                    Command="{Binding DataContext.AddRecommendedTriggerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <TextBlock Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Suggestion.MatchText}"/>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintText}" Margin="0,0,0,6" Text="{Binding RaidSpellSearchStatus}"/>
                                <ListBox Height="150" ItemsSource="{Binding RaidSpellResults}" SelectedItem="{Binding SelectedRaidSpell, Mode=TwoWay}"
                                         DisplayMemberPath="Label"/>
                            </DockPanel>

                            <!-- Right: what to match, how often, where to show it -->
                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Margin" Value="0,3"/>
                                    </Style>
                                </Grid.Resources>

                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Spell name"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RaidSpellName, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Log text to match"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         ToolTip="Filled in with the casting line, for example &quot;begins casting Dragon Roar.&quot;. Case-sensitive; edit it if your log words it differently."
                                         Text="{Binding RaidMatchText, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Recast (seconds)"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                         Text="{Binding RaidRecastSeconds, UpdateSourceTrigger=LostFocus}"/>

                                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Show in overlay"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,3"
                                          ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectedValue="{Binding RaidCategory}"/>

                                <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Announce on start (TTS)"/>
                                <TextBox Grid.Row="4" Grid.Column="1"
                                         ToolTip="Optional. Spoken the moment the trigger starts. May use ${MobName} and ${SpellName}"
                                         Text="{Binding RaidStartTtsText, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="Announce at 10 s left (TTS)"/>
                                <TextBox Grid.Row="5" Grid.Column="1"
                                         ToolTip="Optional. Spoken when 10 seconds remain before the next cast (not used when the recast time is 10 seconds or less). May use ${MobName} and ${SpellName}"
                                         Text="{Binding RaidWarningTtsText, UpdateSourceTrigger=PropertyChanged}"/>

                                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Bottom">
                                    <Button Content="{Binding RaidSaveButtonText}" Command="{Binding AddRaidTriggerCommand}" Margin="0,0,10,0"/>
                                    <Button Content="Cancel edit" Command="{Binding CancelRaidEditCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                                    <Button Content="[ Share {EQO} ]" Command="{Binding ShareRaidBuilderCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,14,0"
                                            ToolTip="Copies this raid timer as an {EQO:...} token you can paste into raid chat."/>
                                    <Button Content="Copy pack" Command="{Binding CopyRaidPackCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                            ToolTip="Copies every saved raid timer for the boss in the Boss box (or all of them if it is empty) as {EQO:...} lines."/>
                                    <Button Content="Import pack" Command="{Binding ImportPackFromClipboardCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,14,0"
                                            ToolTip="Reads {EQO:...} timers from the clipboard and offers each one at the top of the window."/>
                                    <TextBlock Text="{Binding RaidBuilderStatus}" Style="{StaticResource HintText}" VerticalAlignment="Center" MaxWidth="360"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Saved rules -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding RaidRules}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="On" Width="52">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Boss" Binding="{Binding MobText}" Width="140"/>
                            <DataGridTextColumn Header="Spell" Binding="{Binding SpellName}" Width="190"/>
                            <DataGridTextColumn Header="Log text" Binding="{Binding MatchText}" Width="*"/>
                            <DataGridTextColumn Header="Recast (s)" Binding="{Binding RecastSeconds}" Width="84" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Overlay" Binding="{Binding CategoryText}" Width="110"/>
                            <DataGridTextColumn Header="On start" Binding="{Binding StartText}" Width="130"/>
                            <DataGridTextColumn Header="At 10 s left" Binding="{Binding WarningText}" Width="130"/>
                            <DataGridTemplateColumn Width="300">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Edit" Style="{StaticResource SecondaryButton}" Margin="4,1" Padding="10,3"
                                                    Command="{Binding DataContext.EditRaidTriggerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="[ Share {EQO} ]" Style="{StaticResource SecondaryButton}" Margin="4,1" Padding="10,3"
                                                    Command="{Binding DataContext.ShareRaidRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Remove" Style="{StaticResource SecondaryButton}" Margin="4,1" Padding="10,3"
                                                    Command="{Binding DataContext.RemoveRaidTriggerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <CheckBox Content="Learned boss timers" IsChecked="{Binding LearnedBossTimers}"
                                  ToolTip="Counts down to each boss ability from your past kills (median time between casts and of the first cast). A boss needs 2 logged kills; your own rules above win for the same spell."/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding LearnedBossStatus}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ═════════ Tab 4: Spells ═════════ -->
            <TabItem Header="Spells">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox Content="Show songs from all bards" IsChecked="{Binding ShowAllBardSongs}" VerticalAlignment="Center"
                                      ToolTip="On: every bard's songs your logged-in characters see go to the Songs overlay. Off: only songs your own characters sing."/>
                            <TextBlock Style="{StaticResource HintText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="(off: only songs your characters sing)"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Text="{Binding SpellsStatus}"/>
                    </StackPanel>

                    <!-- Track a buff or debuff -->
                    <Border Grid.Row="1" Padding="12" Margin="0,0,0,12" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderSoftBrush}" Background="{DynamicResource WindowBgBrush}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Track a buff or debuff"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Spell (type to search)"/>
                                    <ComboBox Style="{StaticResource SearchComboBox}" MaxDropDownHeight="320"
                                              ItemsSource="{Binding TrackerSuggestions}"
                                              SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}"
                                              Text="{Binding TrackerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                              TextSearch.TextPath="Name"
                                              TextBoxBase.TextChanged="SearchCombo_TextChanged"
                                              PreviewTextInput="SearchCombo_UserInput" PreviewKeyDown="SearchCombo_UserInput">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0" Text="{Binding Detail}"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Show on overlay"/>
                                    <ComboBox ItemsSource="{Binding SpellOverlayOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                              SelectedValue="{Binding TrackerOverlay}"/>
                                </StackPanel>

                                <Button Grid.Column="4" Content="Add to Tracker" VerticalAlignment="Bottom"
                                        Command="{Binding AddTrackedSpellCommand}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                       Text="Songs go to the Songs overlay on their own and don't need adding."/>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" Text="{Binding TrackerPreview}"/>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="{Binding TrackerStatus}"/>
                        </StackPanel>
                    </Border>

                    <!-- List header: summary, filter and the activity line -->
                    <DockPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBox DockPanel.Dock="Right" Width="240" Margin="14,0,0,0"
                                 ToolTip="Filters your list by spell name, landing text or overlay"
                                 Text="{Binding TrackedFilterText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"
                                   Text="{Binding TrackedSummary}"/>
                        <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Text="{Binding TrackerActivity}"/>
                    </DockPanel>

                    <!-- Tracked spells -->
                    <DataGrid Grid.Row="3" ItemsSource="{Binding VisibleTrackedSpells}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="On" Width="52">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Spell" Binding="{Binding Name}" Width="170" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="ID" Binding="{Binding SpellId}" Width="64" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="80" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Counters" Binding="{Binding CountersText, Mode=OneWay}" Width="110" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTemplateColumn Header="Overlay" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="4,2" MinHeight="26"
                                                  ItemsSource="{Binding DataContext.SpellOverlayOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Display" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Overlay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Starts when" Binding="{Binding StartsWhen, Mode=OneWay}" Width="*" MinWidth="110" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Cast on you" Binding="{Binding CastOnYou}" Width="*" MinWidth="110" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Cast on other" Binding="{Binding CastOnOther}" Width="*" MinWidth="110" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Fades" Binding="{Binding SpellFades}" Width="*" MinWidth="110" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTemplateColumn Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Style="{StaticResource SecondaryButton}" Margin="4,1" Padding="10,3"
                                                Command="{Binding DataContext.RemoveTrackedSpellCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ═════════ Tab: AAs & Discs ═════════ -->
            <TabItem Header="AAs &amp; Discs">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource HintText}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="Each time a tracked AA or discipline is used, an &quot;active&quot; bar (how long it lasts) and a &quot;cooldown&quot; bar (until it can be used again) start for the person who used it. One person using it again only restarts their own bars. Choose per ability whether to see everyone in the raid or only the characters you are monitoring, and which overlay each bar appears in."/>

                    <!-- Track an AA or discipline -->
                    <Border Grid.Row="1" Padding="12" Margin="0,0,0,12" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderSoftBrush}" Background="{DynamicResource WindowBgBrush}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Track an AA or discipline"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="190"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Ability (type to search, or type a name in full)"/>
                                    <ComboBox Style="{StaticResource SearchComboBox}" MaxDropDownHeight="320"
                                              ItemsSource="{Binding AbilitySuggestions}"
                                              SelectedItem="{Binding SelectedAbilitySuggestion, Mode=TwoWay}"
                                              Text="{Binding AbilitySearchText, UpdateSourceTrigger=PropertyChanged}"
                                              TextSearch.TextPath="Name"
                                              TextBoxBase.TextChanged="SearchCombo_TextChanged"
                                              PreviewTextInput="SearchCombo_UserInput" PreviewKeyDown="SearchCombo_UserInput">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0" Text="{Binding Detail}"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Lasts" ToolTip="How long the ability lasts, e.g. 3:00. Blank = no active bar."/>
                                    <TextBox Text="{Binding AbilityActiveText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Cooldown" ToolTip="How long until it can be used again, e.g. 10:30. Blank = no cooldown bar."/>
                                    <TextBox Text="{Binding AbilityCooldownText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Whose use to show"/>
                                    <ComboBox ItemsSource="{Binding ScopeOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                              SelectedValue="{Binding AbilityScope}"/>
                                </StackPanel>
                            </Grid>

                            <WrapPanel Margin="0,10,0,0">
                                <StackPanel Margin="0,0,14,0" Width="190">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Active bar overlay"/>
                                    <ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                              SelectedValue="{Binding AbilityActiveOverlay}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0" Width="190">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Cooldown bar overlay"/>
                                    <ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                              SelectedValue="{Binding AbilityCooldownOverlay}"/>
                                </StackPanel>
                                <Button Content="Add to Tracker" VerticalAlignment="Bottom" Command="{Binding AddAbilityCommand}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" Text="{Binding AbilityStatus}"/>
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"
                                   Text="{Binding AbilitySummary}"/>
                        <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Text="{Binding AbilityActivity}"/>
                    </DockPanel>

                    <!-- Tracked abilities -->
                    <DataGrid Grid.Row="3" ItemsSource="{Binding TrackedAbilities}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="On" Width="52">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Ability" Binding="{Binding Name}" Width="150" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTemplateColumn Header="Lasts" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Margin="4,2" MinHeight="26" Text="{Binding ActiveText, UpdateSourceTrigger=LostFocus}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Active overlay" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="4,2" MinHeight="26"
                                                  ItemsSource="{Binding DataContext.CategoryOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Display" SelectedValuePath="Value"
                                                  SelectedValue="{Binding ActiveOverlay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Cooldown" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Margin="4,2" MinHeight="26" Text="{Binding CooldownText, UpdateSourceTrigger=LostFocus}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Cooldown overlay" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="4,2" MinHeight="26"
                                                  ItemsSource="{Binding DataContext.CategoryOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Display" SelectedValuePath="Value"
                                                  SelectedValue="{Binding CooldownOverlay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Whose use" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Margin="4,2" MinHeight="26"
                                                  ItemsSource="{Binding DataContext.ScopeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Display" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Scope, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Starts when" Binding="{Binding StartsWhen, Mode=OneWay}" Width="*" MinWidth="130" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Fades" Binding="{Binding FadesText, Mode=OneWay}" Width="*" MinWidth="120" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTemplateColumn Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Style="{StaticResource SecondaryButton}" Margin="4,1" Padding="10,3"
                                                Command="{Binding DataContext.RemoveAbilityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Class cooldown tracker -->
                    <GroupBox Grid.Row="4" Header="Built-in: Divine Aura" Margin="0,10,0,0">
                        <StackPanel Margin="4">
                            <CheckBox Content="Track class cooldowns (starts a bar when the ability is used)"
                                      IsChecked="{Binding IsCooldownTrackerEnabled}" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6"
                                       Text="The Cleric Divine Aura spell and the two Divine Aura AAs all end with &quot;A divine aura surrounds you.&quot;; the line before it tells them apart. Bars appear in the Raid Triggers overlay. Divine Aura needs this built-in tracker because its three versions share one landing message."/>
                            <ItemsControl ItemsSource="{Binding CooldownRules}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock DockPanel.Dock="Left" Width="300" FontWeight="SemiBold" Text="{Binding Label}"/>
                                            <TextBlock DockPanel.Dock="Left" Width="70" Text="{Binding CooldownText}" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Style="{StaticResource HintText}" Text="{Binding Detection}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ═════════ Tab 5: DPS & Encounter History ═════════ -->
            <TabItem Header="Encounter DPS">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Source selector + exports -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <WrapPanel HorizontalAlignment="Left">
                            <Button Content="[ Copy Top 12 for EQ Chat ]" Command="{Binding CopyTop12ForChatCommand}" Margin="0,0,8,0"
                                    ToolTip="Copies the selected fight and its top 12 attackers as text for EverQuest chat."/>
                            <Button Content="[ Copy Image for Discord ]" Command="{Binding CopyImageForDiscordCommand}" Margin="0,0,8,0"
                                    ToolTip="Copies the selected fight as one picture with the damage dealt and the damage taken, ready to paste into Discord."/>
                            <Button Content="Colors..." Command="{Binding OpenColorsCommand}" Style="{StaticResource SecondaryButton}"
                                    ToolTip="Choose the colors of each attack type, pets and healing in the Discord picture, with a preview."/>
                        </WrapPanel>
                    </DockPanel>

                    <!-- Every log loads by itself; this line only reports on it. -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource HintText}" Text="{Binding ImportStatus}"/>
                        <ProgressBar Width="200" Height="8" Margin="12,0,0,0" Minimum="0" Maximum="100" Value="{Binding ImportProgress}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsImporting}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </StackPanel>

                    <!-- Encounter browser + participant breakdown -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MaxWidth="560"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0" HorizontalAlignment="Left" ItemsSource="{Binding Encounters}" SelectedItem="{Binding SelectedEncounter, Mode=TwoWay}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Target" Binding="{Binding TargetName}" Width="Auto" MinWidth="120"/>
                                <DataGridTextColumn Header="Start" Binding="{Binding StartText}" SortMemberPath="StartTime" Width="Auto"/>
                                <DataGridTextColumn Header="Length" Binding="{Binding DurationText}" SortMemberPath="DurationSeconds" Width="Auto"
                                                    ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Damage" Binding="{Binding TotalDamage, StringFormat=N0}" Width="Auto"
                                                    ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Group DPS" Binding="{Binding GroupDps, StringFormat=N0}" Width="Auto"
                                                    ElementStyle="{StaticResource NumericCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Right half: damage dealt on top, damage taken below. -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"
                                           Text="{Binding EncounterSummary}"/>
                                <DataGrid ItemsSource="{Binding Participants}" HorizontalAlignment="Left"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          FrozenColumnCount="2" HorizontalScrollBarVisibility="Auto"
                                          RowDetailsVisibilityMode="Visible">
                                    <DataGrid.RowDetailsTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PetText}" Style="{StaticResource HintText}" Margin="34,0,0,3">
                                                <TextBlock.Visibility>
                                                    <Binding Path="HasPets">
                                                        <Binding.Converter>
                                                            <BooleanToVisibilityConverter/>
                                                        </Binding.Converter>
                                                    </Binding>
                                                </TextBlock.Visibility>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGrid.RowDetailsTemplate>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Name" Binding="{Binding DisplayName, Mode=OneWay}" Width="Auto"/>
                                        <DataGridTextColumn Header="Class" Binding="{Binding Class}" Width="Auto"/>
                                        <DataGridTextColumn Header="Class Rank" Binding="{Binding Benchmark}" Width="Auto"/>
                                        <DataGridTemplateColumn Header="Total damage" Width="170" SortMemberPath="TotalDamage">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding BarFraction, Mode=OneWay}" Height="16"
                                                                     BorderThickness="0" Background="Transparent"
                                                                     Foreground="{DynamicResource AccentBrush}" Opacity="0.45"/>
                                                        <TextBlock Text="{Binding TotalDamage, StringFormat=N0}" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="% of group" Binding="{Binding DamagePercent, StringFormat={}{0:0.0}%}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Scaled DPS" Binding="{Binding ScaledDps, StringFormat=N1}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="DPS" Binding="{Binding Dps, StringFormat=N1}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Max hit" Binding="{Binding MaxHit, StringFormat=N0}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Max crit" Binding="{Binding MaxCritHit, StringFormat=N0}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Hits" Binding="{Binding Hits, StringFormat=N0}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Misses" Binding="{Binding Misses, StringFormat=N0}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Hit rate" Binding="{Binding HitRatePercent, StringFormat={}{0:0.0}%}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Crit %" Binding="{Binding CritRatePercent, StringFormat={}{0:0.0}%}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <TabControl Grid.Row="2">
                                <TabItem Header="Damage Taken">
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"
                                                   Text="{Binding DamageTakenSummary}"/>
                                        <DataGrid ItemsSource="{Binding DamageTaken}" HorizontalAlignment="Left"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          FrozenColumnCount="2" HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Name" Binding="{Binding DisplayName, Mode=OneWay}" Width="Auto"/>
                                        <DataGridTemplateColumn Header="Damage taken" Width="170" SortMemberPath="TotalDamage">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding BarFraction, Mode=OneWay}" Height="16"
                                                                     BorderThickness="0" Background="Transparent" Foreground="#E5845C" Opacity="0.55"/>
                                                        <TextBlock Text="{Binding TotalDamage, StringFormat=N0}" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="% of total" Binding="{Binding PercentOfTotal, StringFormat={}{0:0.0}%}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Hits" Binding="{Binding Hits, StringFormat=N0}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Avoid %" Binding="{Binding AvoidPercent, StringFormat={}{0:0.00}%}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Dodge %" Binding="{Binding DodgePercent, StringFormat={}{0:0.00}%}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Parry %" Binding="{Binding ParryPercent, StringFormat={}{0:0.00}%}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Block %" Binding="{Binding BlockPercent, StringFormat={}{0:0.00}%}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Riposte %" Binding="{Binding RipostePercent, StringFormat={}{0:0.00}%}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Miss %" Binding="{Binding MissPercent, StringFormat={}{0:0.00}%}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Other %" Binding="{Binding OtherAvoidPercent, StringFormat={}{0:0.00}%}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Max hit" Binding="{Binding MaxHit, StringFormat=N0}" Width="Auto"
                                                            ElementStyle="{StaticResource NumericCell}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                    </DockPanel>
                                </TabItem>

                                <TabItem Header="Graph">
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"
                                                   Text="Damage per second through the fight: the whole group (thick line) and the top five damage dealers."/>
                                        <ctl:DpsGraphControl Timeline="{Binding EncounterTimeline}" MinHeight="220"/>
                                    </DockPanel>
                                </TabItem>

                                <TabItem Header="Boss Abilities">
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"
                                                   Text="{Binding BossAbilitySummary}"/>
                                        <DataGrid HorizontalAlignment="Left" ItemsSource="{Binding BossAbilityRows}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Spell" Binding="{Binding Spell, Mode=OneWay}" Width="Auto"/>
                                                <DataGridTextColumn Header="Casts" Binding="{Binding Casts, Mode=OneWay}" Width="Auto"
                                                                    ElementStyle="{StaticResource NumericCell}"/>
                                                <DataGridTextColumn Header="Interval" Binding="{Binding Every, Mode=OneWay}" Width="Auto"/>
                                                <DataGridTextColumn Header="When (into the fight)" Binding="{Binding Times, Mode=OneWay}" Width="Auto"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>

                                <TabItem Header="Deaths">
                                    <DataGrid Margin="0,6,0,0" HorizontalAlignment="Left" ItemsSource="{Binding DeathRows}"
                                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Into the fight" Binding="{Binding When, Mode=OneWay}" Width="Auto"/>
                                            <DataGridTextColumn Header="Who died" Binding="{Binding Name, Mode=OneWay}" Width="Auto"/>
                                            <DataGridTextColumn Header="Killed by" Binding="{Binding KilledBy, Mode=OneWay}" Width="Auto"/>
                                            <DataGridTextColumn Header="Killing Blow" Binding="{Binding KillingBlow, Mode=OneWay}" Width="Auto"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>

                                <TabItem Header="Healing">
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"
                                                   Text="{Binding HealingSummary}"/>
                                        <DataGrid HorizontalAlignment="Left" ItemsSource="{Binding HealingRows}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding Rank, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                                <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="Auto"/>
                                                <DataGridTextColumn Header="Healed" Binding="{Binding Effective, StringFormat=N0, Mode=OneWay}" Width="Auto"
                                                                    ElementStyle="{StaticResource NumericCell}"/>
                                                <DataGridTextColumn Header="HPS" Binding="{Binding Hps, StringFormat=N1, Mode=OneWay}" Width="Auto"
                                                                    ElementStyle="{StaticResource NumericCell}"/>
                                                <DataGridTextColumn Header="Overheal %" Binding="{Binding OverhealPercent, StringFormat={}{0:0.0}%, Mode=OneWay}" Width="Auto"
                                                                    ElementStyle="{StaticResource NumericCell}"/>
                                                <DataGridTextColumn Header="Heals" Binding="{Binding Heals, StringFormat=N0, Mode=OneWay}" Width="Auto"
                                                                    ElementStyle="{StaticResource NumericCell}"/>
                                                <DataGridTextColumn Header="Biggest" Binding="{Binding MaxHeal, StringFormat=N0, Mode=OneWay}" Width="Auto"
                                                                    ElementStyle="{StaticResource NumericCell}"/>
                                                <DataGridTextColumn Header="Main spell" Binding="{Binding TopSpell, Mode=OneWay}" Width="Auto"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="Uptime">
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"
                                                   Text="{Binding UptimeSummary}"/>
                                        <DataGrid HorizontalAlignment="Left" ItemsSource="{Binding UptimeRows}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Spell" Binding="{Binding Spell, Mode=OneWay}" Width="Auto"/>
                                                <DataGridTextColumn Header="On" Binding="{Binding Target, Mode=OneWay}" Width="Auto"/>
                                                <DataGridTextColumn Header="Up for" Binding="{Binding Up, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                                <DataGridTextColumn Header="% of fight" Binding="{Binding Percent, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="Spell Casts">
                                    <Grid Margin="0,6,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"
                                                   Text="{Binding SpellCastSummary}"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Spell" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Width="220" Text="{Binding SpellCastFilter, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Only spells whose name contains this, e.g. slow or weaken"/>
                                            <Button Content="Copy" Command="{Binding CopySpellCastsCommand}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/>
                                        </StackPanel>
                                        <TabControl Grid.Row="2">
                                            <TabItem Header="By Player">
                                                <DataGrid Margin="0,6,0,0" HorizontalAlignment="Left" ItemsSource="{Binding SpellCastPlayerRows}"
                                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Auto">
                                                    <DataGrid.RowStyle>
                                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGrid.RowStyle>
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Player / spell" Binding="{Binding Name, Mode=OneWay}" Width="Auto"/>
                                                        <DataGridTextColumn Header="Casts" Binding="{Binding Casts, Mode=OneWay}" Width="Auto"
                                                                            ElementStyle="{StaticResource NumericCell}"/>
                                                        <DataGridTextColumn Header="Per min" Binding="{Binding PerMinute, Mode=OneWay}" Width="Auto"
                                                                            ElementStyle="{StaticResource NumericCell}"/>
                                                        <DataGridTextColumn Header="First" Binding="{Binding First, Mode=OneWay}" Width="Auto"
                                                                            ElementStyle="{StaticResource NumericCell}"/>
                                                        <DataGridTextColumn Header="Last" Binding="{Binding Last, Mode=OneWay}" Width="Auto"
                                                                            ElementStyle="{StaticResource NumericCell}"/>
                                                        <DataGridTextColumn Header="Fizzled" Binding="{Binding Failed, Mode=OneWay}" Width="Auto"
                                                                            ElementStyle="{StaticResource NumericCell}"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </TabItem>
                                            <TabItem Header="By Spell">
                                                <DataGrid Margin="0,6,0,0" HorizontalAlignment="Left" ItemsSource="{Binding SpellCastTotalRows}"
                                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Auto">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Spell" Binding="{Binding Spell, Mode=OneWay}" Width="Auto"/>
                                                        <DataGridTextColumn Header="Casts" Binding="{Binding Casts, Mode=OneWay}" Width="Auto"
                                                                            ElementStyle="{StaticResource NumericCell}"/>
                                                        <DataGridTextColumn Header="Casters" Binding="{Binding Casters, Mode=OneWay}" Width="Auto"
                                                                            ElementStyle="{StaticResource NumericCell}"/>
                                                        <DataGridTextColumn Header="Per min" Binding="{Binding PerMinute, Mode=OneWay}" Width="Auto"
                                                                            ElementStyle="{StaticResource NumericCell}"/>
                                                        <DataGridTextColumn Header="Most casts by" Binding="{Binding TopCaster, Mode=OneWay}" Width="Auto"/>
                                                        <DataGridTextColumn Header="Fizzled" Binding="{Binding Failed, Mode=OneWay}" Width="Auto"
                                                                            ElementStyle="{StaticResource NumericCell}"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </TabItem>
                                            <TabItem Header="Timeline">
                                                <ScrollViewer Margin="0,6,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                    <ctl:CastTimelineControl Lanes="{Binding SpellCastLanes}" DurationSeconds="{Binding SpellCastDuration}"
                                                                             HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                </ScrollViewer>
                                            </TabItem>
                                        </TabControl>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═════════ Loot ═════════ -->
            <TabItem Header="Loot">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <ComboBox Width="170" Margin="0,0,10,6" ItemsSource="{Binding LootViews}" SelectedIndex="{Binding LootViewIndex}"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Search"/>
                        <TextBox Width="220" Margin="0,0,10,6" VerticalAlignment="Center"
                                 ToolTip="Every word has to be found in the item, the looter or the mob, so &quot;seru sword&quot; finds swords from Seru. Put a phrase in quotes to keep it together."
                                 Text="{Binding LootFilter, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox Width="130" Margin="0,0,14,6" ItemsSource="{Binding LootRanges}" SelectedIndex="{Binding LootRangeIndex}"
                                  ToolTip="How far back to look."/>
                        <Button Content="Read All Logs" Margin="0,0,8,6" Command="{Binding ScanLootFromPrimaryLogCommand}"
                                ToolTip="Adds the loot from every character's log (the number of days set in Settings). Loot seen in several logs counts once."/>
                        <Button Content="Read a log file…" Margin="0,0,8,6" Style="{StaticResource SecondaryButton}" Command="{Binding ScanLootLogCommand}"/>
                        <Button Content="Copy" Margin="0,0,8,6" Style="{StaticResource SecondaryButton}" Command="{Binding CopyLootCommand}"
                                ToolTip="Copies the list you are looking at as text for Discord."/>
                        <Button Content="Clear" Margin="0,0,8,6" Style="{StaticResource SecondaryButton}" Command="{Binding ClearLootCommand}"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Style="{StaticResource HintText}" Margin="0,0,0,8" Text="{Binding LootStatus}"/>

                    <Grid Grid.Row="2">
                        <DataGrid ItemsSource="{Binding LootLineRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLootLinesView}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Item" Binding="{Binding Item, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Looted by" Binding="{Binding Looter, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="From" Binding="{Binding Mob, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Roll won" Binding="{Binding Roll, Mode=OneWay}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid ItemsSource="{Binding LootMobRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLootMobView}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mob" Binding="{Binding Mob, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Item" Binding="{Binding Item, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Count" Binding="{Binding Count, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Looted by" Binding="{Binding Looters, Mode=OneWay}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid ItemsSource="{Binding LootSummaryRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLootSummaryView}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item" Binding="{Binding Item, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Count" Binding="{Binding Count, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Looted by" Binding="{Binding Looters, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="From" Binding="{Binding Mobs, Mode=OneWay}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid ItemsSource="{Binding LootCharacterRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLootCharacterView}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Character" Binding="{Binding Looter, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Item" Binding="{Binding Item, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Count" Binding="{Binding Count, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="From" Binding="{Binding Mobs, Mode=OneWay}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid ItemsSource="{Binding MoneyMobRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMoneyMobView}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mob" Binding="{Binding Name, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Splits" Binding="{Binding Splits, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Per character" Binding="{Binding Detail, Mode=OneWay}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid ItemsSource="{Binding MoneyCharacterRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMoneyCharacterView}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Character" Binding="{Binding Name, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Splits" Binding="{Binding Splits, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Mobs" Binding="{Binding Detail, Mode=OneWay}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═════════ Drop table ═════════ -->
            <TabItem Header="Drop Table">
                <Grid Margin="6">
                    <Grid.Resources>
                        <Style x:Key="DropViewTab" TargetType="RadioButton">
                            <Setter Property="Margin" Value="0,0,6,0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Box" Padding="12,5" CornerRadius="6" BorderThickness="1"
                                                BorderBrush="{DynamicResource BorderSoftBrush}" Background="Transparent">
                                            <ContentPresenter x:Name="Text" TextElement.Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Text" Property="TextElement.Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="DropTableOnly" TargetType="FrameworkElement">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDropTableView}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="DropSharingOnly" TargetType="FrameworkElement">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDropSharingView}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                        <RadioButton DockPanel.Dock="Left" GroupName="DropViews" Style="{StaticResource DropViewTab}" Content="By Mob" IsChecked="{Binding IsDropsByMob, Mode=TwoWay}"/>
                        <RadioButton DockPanel.Dock="Left" GroupName="DropViews" Style="{StaticResource DropViewTab}" Content="By Item" IsChecked="{Binding IsDropsByItem, Mode=TwoWay}"/>
                        <RadioButton DockPanel.Dock="Right" GroupName="DropViews" Style="{StaticResource DropViewTab}" Content="Sharing" IsChecked="{Binding IsDropsSharing, Mode=TwoWay}"/>
                        <Button DockPanel.Dock="Right" Margin="0,0,10,0" Content="Scan log history" Style="{StaticResource SecondaryButton}" Command="{Binding ScanDropsCommand}"
                                ToolTip="Reads every watched log from the start again. Kills and drops seen before are not counted twice."/>
                    </DockPanel>

                    <!-- The table -->
                    <Grid Grid.Row="1" Style="{StaticResource DropTableOnly}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabel}" Text="Server"/>
                                <ComboBox ItemsSource="{Binding DropServers}" SelectedItem="{Binding SelectedDropServer, Mode=TwoWay}"
                                          ToolTip="Each server's drops are kept apart; random-loot servers never mix with others."/>
                            </DockPanel>
                            <DockPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabel}" Text="Zone"/>
                                <ComboBox ItemsSource="{Binding DropZones}" SelectedItem="{Binding SelectedDropZone, Mode=TwoWay}"/>
                            </DockPanel>
                            <DockPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabel}" Text="Source"/>
                                <ComboBox ItemsSource="{Binding DropSources}" SelectedItem="{Binding SelectedDropSource, Mode=TwoWay}"/>
                            </DockPanel>
                            <DockPanel Grid.Column="3">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabel}" Text="Search"/>
                                <TextBox Text="{Binding DropSearch, UpdateSourceTrigger=PropertyChanged, Delay=250}" ToolTip="A mob or item name, or part of one."/>
                            </DockPanel>
                        </Grid>
                        <DataGrid Grid.Row="1" HorizontalAlignment="Left" ItemsSource="{Binding DropRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserSortColumns="False"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Background" Value="{DynamicResource WindowBgBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="Auto" MinWidth="160">
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DataContext.DropFirstColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Margin="8,0,4,0" VerticalAlignment="Center" FontWeight="Normal">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatsItem}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Hyperlink Command="{Binding DataContext.OpenItemStatsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                               CommandParameter="{Binding StatsItem}" ToolTip="Opens the item's Allakhazam page in your browser.">stats ↗</Hyperlink>
                                                </TextBlock>
                                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Margin" Value="18,0,0,0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                                                    <Setter Property="Margin" Value="2,0,0,0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Zone" Binding="{Binding Zone, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Kills" Binding="{Binding Kills, Mode=OneWay}" Width="Auto" MinWidth="56" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Drops" Binding="{Binding Drops, Mode=OneWay}" Width="Auto" MinWidth="56" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTemplateColumn Header="Rate" Width="Auto" MinWidth="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Height="6" CornerRadius="3" Margin="0,0,6,0" VerticalAlignment="Center" Width="{Binding RateBar}"
                                                        Background="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="{Binding Rate}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Style="{StaticResource HintText}" Margin="0,8,0,0" Text="{Binding DropStatus}"/>
                    </Grid>

                    <!-- Sharing -->
                    <ScrollViewer Grid.Row="1" Style="{StaticResource DropSharingOnly}" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Shared online"/>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8"
                                       Text="Pool drops with every EQ Overwatch player on your server. What is sent: each kill and drop's mob, item, zone and time, under a random id. No character names, nothing else. Uploads are merged once a day at 10:00 UTC: a fight several players logged counts once, and a drop only counts when the same player logged the kill."/>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8" Text="The sharing switches are in Settings, under Sharing."/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Button Content="Check now" Style="{StaticResource SecondaryButton}" Command="{Binding SyncSharedDropsNowCommand}"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="620" Text="{Binding SharedDropsStatus}"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="Drops files"/>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8"
                                       Text="Share your drop table by hand, for example in a Discord channel. A file holds one server's kills and drops: item, mob, zone and time. No character names. Importing a file from someone who logged the same fights counts each one once."/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Server"/>
                                <ComboBox Width="180" ItemsSource="{Binding DropServers}" SelectedItem="{Binding DropExportServer, Mode=TwoWay}"/>
                                <Button Margin="10,0,6,0" Content="Export drops file…" Command="{Binding ExportDropsCommand}"/>
                                <Button Content="Import drops file…" Style="{StaticResource SecondaryButton}" Command="{Binding ImportDropsCommand}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Your tag"/>
                                <TextBox Width="180" Text="{Binding DropTag, UpdateSourceTrigger=LostFocus}" ToolTip="The name your drops files carry. It's random to start with; never a character name unless you type one."/>
                                <Button Margin="10,0,0,0" Content="New tag" Style="{StaticResource SecondaryButton}" Command="{Binding NewDropTagCommand}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,12" Text="{Binding DropShareStatus}"/>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="Imported files"/>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6" Text="Importing a newer file from the same tag replaces the older one. Remove takes a file's drops back out of your table."/>
                            <ItemsControl ItemsSource="{Binding DropImports}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                                                    Command="{Binding DataContext.RemoveDropImportCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Text}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ═════════ Attendance ═════════ -->
            <TabItem Header="Attendance">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="*" MinHeight="110"/>
                    </Grid.RowDefinitions>


                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Row="2" Grid.ColumnSpan="5" Margin="0,12,0,0">
                        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6" Text="Idle in boss fights"/>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Boss kills from the Encounter DPS list near the selected raid's dump, with the raid members who did no damage, healing or casting in them."/>
                        <DataGrid ItemsSource="{Binding IdleFightRows}" HorizontalAlignment="Left" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fight" Binding="{Binding Fight, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Start" Binding="{Binding When, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Idle" Binding="{Binding IdleCount, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Who" Binding="{Binding Idle, Mode=OneWay}" Width="Auto" MaxWidth="900" ElementStyle="{StaticResource WrapCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <WrapPanel Grid.Row="0" Grid.ColumnSpan="5" Margin="0,0,0,8">
                        <Button Content="Read new dumps" Margin="0,0,8,6" Command="{Binding RefreshAttendanceCommand}"
                                ToolTip="Looks in your EverQuest folder for new RaidRoster_ files (the Raid window's Dump button writes them)."/>
                        <Button Content="Copy raid" Margin="0,0,8,6" Style="{StaticResource SecondaryButton}" Command="{Binding CopyAttendanceCommand}"
                                ToolTip="Copies the selected raid's roster as text for Discord."/>
                        <Button Content="Delete raid" Margin="0,0,14,6" Style="{StaticResource SecondaryButton}" Command="{Binding DeleteAttendanceCommand}"/>
                        <ComboBox Width="130" Margin="0,0,8,6" ItemsSource="{Binding AttendanceRanges}" SelectedIndex="{Binding AttendanceRangeIndex}"
                                  ToolTip="Which raids the totals on the right count."/>
                        <Button Content="Copy totals" Margin="0,0,14,6" Style="{StaticResource SecondaryButton}" Command="{Binding CopyAttendanceTotalsCommand}"
                                ToolTip="Copies the totals as tab-separated lines that paste into a spreadsheet."/>
                        <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,0,6" Text="{Binding AttendanceStatus}"/>
                    </WrapPanel>

                    <DockPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6" Text="Raids"/>
                        <DataGrid ItemsSource="{Binding AttendanceRaids}" SelectedItem="{Binding SelectedAttendanceRaid, Mode=TwoWay}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="When" Binding="{Binding When, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Server" Binding="{Binding Server, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Present" Binding="{Binding Members, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <DockPanel Grid.Row="1" Grid.Column="2">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="Who was there"/>
                            <ComboBox Width="190" Margin="12,0,0,0" HorizontalAlignment="Left" ItemsSource="{Binding RosterViews}" SelectedIndex="{Binding RosterViewIndex}"
                                      ToolTip="Everyone in the raid, the raid's groups (a group without a cleric, druid or shaman is flagged), or guild members who missed it."/>
                        </DockPanel>
                        <Grid>
                            <DataGrid ItemsSource="{Binding RosterRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalAlignment="Left"
                                      Visibility="{Binding ShowRosterList, Converter={StaticResource BoolToVisibility}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Group" Binding="{Binding Group, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="Auto"/>
                                    <DataGridTextColumn Header="Level" Binding="{Binding Level, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                    <DataGridTextColumn Header="Class" Binding="{Binding Class, Mode=OneWay}" Width="Auto"/>
                                    <DataGridTextColumn Header="Role" Binding="{Binding Role, Mode=OneWay}" Width="Auto"/>
                                    <DataGridTextColumn Header="Rank" Binding="{Binding Rank, Mode=OneWay}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowRosterGroups, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding RaidGroupCards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="1" BorderBrush="{DynamicResource BorderSoftBrush}" CornerRadius="6" Padding="8,6" Margin="0,0,8,8" MinWidth="170">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}"/>
                                                    <TextBlock Text="{Binding Warning}" Foreground="#E24B4A" Margin="0,2,0,0"
                                                               Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBlock Text="{Binding Members}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <DockPanel Visibility="{Binding ShowRosterMissed, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding GuildStatus}"/>
                                <DataGrid ItemsSource="{Binding GuildMissRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalAlignment="Left">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="Auto"/>
                                        <DataGridTextColumn Header="Level" Binding="{Binding Level, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Class" Binding="{Binding Class, Mode=OneWay}" Width="Auto"/>
                                        <DataGridTextColumn Header="Rank" Binding="{Binding Rank, Mode=OneWay}" Width="Auto"/>
                                        <DataGridTextColumn Header="Last on" Binding="{Binding LastOn, Mode=OneWay}" Width="Auto"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>

                    <DockPanel Grid.Row="1" Grid.Column="4">
                        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6" Text="Attendance over all raids"/>
                        <DataGrid ItemsSource="{Binding AttendanceTotals}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Class" Binding="{Binding Class, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Raids" Binding="{Binding Present, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Of" Binding="{Binding Raids, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="%" Binding="{Binding Percent, StringFormat={}{0:0}%, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen, Mode=OneWay}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ═════════ Items & Scrolls ═════════ -->
            <TabItem Header="Items &amp; Scrolls">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                        <WrapPanel>
                        <Button Content="Read new files" Margin="0,0,14,6" Command="{Binding RefreshCharacterToolsCommand}"
                                ToolTip="Reads any new /outputfile files for your characters from the EverQuest folder."/>
                        <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,0,6" Text="{Binding ScrollPlanStatus}"/>
                    </WrapPanel>
                        <WrapPanel Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Game commands" VerticalAlignment="Center"
                                       ToolTip="Click one to copy it, then paste it into the game's chat on each character."/>
                            <Button Content="/outputfile inventory" Margin="0,0,8,6" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CopyGameCommandCommand}" CommandParameter="/outputfile inventory"/>
                            <Button Content="/outputfile spellbook" Margin="0,0,8,6" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CopyGameCommandCommand}" CommandParameter="/outputfile spellbook"/>
                            <Button Content="/outputfile missingspells" Margin="0,0,8,6" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CopyGameCommandCommand}" CommandParameter="/outputfile missingspells"/>
                            <Button Content="Copy all three" Margin="0,0,8,6" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CopyAllGameCommandsCommand}"
                                    ToolTip="Puts the three commands on the clipboard, one per line, for pasting into a game macro."/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                   Text="Paste one command at a time into the game chat. To cover a character in one click, make a game macro or hotbar button with the three commands on separate lines, then click it on each character."/>
                    </StackPanel>

                    <DockPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6" Text="Find an item on any character"/>
                        <TextBox DockPanel.Dock="Top" Margin="0,0,0,6"
                                 Text="{Binding ItemSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintText}" Margin="0,0,0,6" Text="{Binding ItemSearchStatus}"/>
                        <DataGrid ItemsSource="{Binding ItemHits}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Character" Binding="{Binding Character, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Where" Binding="{Binding Where, Mode=OneWay}" Width="Auto" MaxWidth="220" ElementStyle="{StaticResource WrapCell}"/>
                                <DataGridTextColumn Header="Item" Binding="{Binding Item, Mode=OneWay}" Width="*" MinWidth="120" ElementStyle="{StaticResource WrapCell}"/>
                                <DataGridTextColumn Header="Count" Binding="{Binding Count, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <Grid Grid.Row="1" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6" Text="Scrolls you carry that a character needs"/>
                            <DataGrid ItemsSource="{Binding ScrollRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Spell" Binding="{Binding Spell, Mode=OneWay}" Width="Auto"/>
                                    <DataGridTextColumn Header="Needed by" Binding="{Binding NeededBy, Mode=OneWay}" Width="*" MinWidth="100" ElementStyle="{StaticResource WrapCell}"/>
                                    <DataGridTextColumn Header="Carried by" Binding="{Binding HeldBy, Mode=OneWay}" Width="*" MinWidth="100" ElementStyle="{StaticResource WrapCell}"/>
                                    <DataGridTextColumn Header="Server" Binding="{Binding Server, Mode=OneWay}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <DockPanel Grid.Row="2">
                            <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6" Text="Shopping list: missing spells nobody has a scroll for"/>
                            <DataGrid ItemsSource="{Binding ShoppingRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Level" Binding="{Binding Level, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                    <DataGridTextColumn Header="Spell" Binding="{Binding Spell, Mode=OneWay}" Width="Auto"/>
                                    <DataGridTextColumn Header="Needed by" Binding="{Binding NeededBy, Mode=OneWay}" Width="*" MinWidth="100" ElementStyle="{StaticResource WrapCell}"/>
                                    <DataGridTextColumn Header="Server" Binding="{Binding Server, Mode=OneWay}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═════════ Mob History ═════════ -->
            <TabItem Header="Mob History">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <RadioButton Content="Mobs" GroupName="MobHistoryView" Margin="0,0,10,6" VerticalAlignment="Center" IsChecked="{Binding ShowMobsView}"/>
                        <RadioButton Content="Server Firsts" GroupName="MobHistoryView" Margin="0,0,22,6" VerticalAlignment="Center" IsChecked="{Binding ShowServerFirsts}"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Fights with"/>
                        <ComboBox Width="130" Margin="0,0,14,6" ItemsSource="{Binding BossHistorySizes}" SelectedIndex="{Binding BossHistorySizeIndex}"
                                  ToolTip="Hides small fights, such as trash and solo kills."/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Mob"/>
                        <TextBox Width="200" Margin="0,0,14,6" VerticalAlignment="Center"
                                 Text="{Binding BossHistoryFilter, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Clear history" Margin="0,0,22,6" Style="{StaticResource SecondaryButton}" Command="{Binding ClearBossHistoryCommand}"
                                ToolTip="Forgets the saved fights. They come back from your logs the next time history is loaded."/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Resists"/>
                        <RadioButton Content="Mine" GroupName="ResistView" Margin="0,0,10,6" VerticalAlignment="Center" IsChecked="{Binding ResistMineView}"
                                     ToolTip="Resist % from your characters' own spells only."/>
                        <RadioButton Content="Raid" GroupName="ResistView" Margin="0,0,14,6" VerticalAlignment="Center" IsChecked="{Binding ResistRaidView}"
                                     ToolTip="Your characters plus every player who shared resists in raid or guild chat."/>
                        <Button Content="Share resists" Margin="0,0,8,6" Style="{StaticResource SecondaryButton}" Command="{Binding ShareResistsCommand}"
                                ToolTip="Copies the selected mob's resists (your characters' numbers) as a line to paste into /rs or /gu. Other Overwatch users in the raid pick it up."/>
                        <Button Content="Share all" Margin="0,0,8,6" Style="{StaticResource SecondaryButton}" Command="{Binding ShareAllResistsCommand}"
                                ToolTip="Copies one chat line with your resists for the mobs you cast on most recently. Click again for the next line."/>
                    </WrapPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding BossHistoryStatus}"/>
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding MobStatsFreshness}"/>
                    </StackPanel>

                    <!-- Server Firsts: each boss's first kill on the server, open raid targets, guild counts and class benchmarks -->
                    <Grid Grid.Row="2" Visibility="{Binding ShowServerFirsts, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Server"/>
                            <ComboBox Width="150" Margin="0,0,14,6" ItemsSource="{Binding FirstsServers}" SelectedItem="{Binding SelectedFirstsServer}"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Guild"/>
                            <ComboBox Width="220" Margin="0,0,14,6" ItemsSource="{Binding FirstsGuilds}" SelectedItem="{Binding SelectedFirstsGuild}"/>
                            <Button Content="View fight" Margin="0,0,14,6" Style="{StaticResource SecondaryButton}" Command="{Binding ViewFirstFightCommand}"
                                    ToolTip="Shows the selected Server First as a picture, with each player's class rank on that boss."/>
                            <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,0,6" Text="{Binding FirstsStatus}"/>
                        </WrapPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DataGrid Grid.Column="0" ItemsSource="{Binding ServerFirstRows}" SelectedItem="{Binding SelectedFirstRow, Mode=TwoWay}" HorizontalAlignment="Left"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" VerticalAlignment="Top"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Boss" Binding="{Binding Mob, Mode=OneWay}" Width="Auto"/>
                                    <DataGridTextColumn Header="Expansion" Binding="{Binding Expansion, Mode=OneWay}" Width="Auto"/>
                                    <DataGridTextColumn Header="First Kill" Binding="{Binding Date, Mode=OneWay}" Width="Auto"/>
                                    <DataGridTextColumn Header="Guild" Binding="{Binding Guild, Mode=OneWay}" Width="Auto"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="Auto"/>
                                    <DataGridTextColumn Header="Witnesses" Binding="{Binding Witnesses, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                    <DataGridTextColumn Header="Players" Binding="{Binding Players, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" Text="Server Firsts by guild"/>
                                <DataGrid ItemsSource="{Binding GuildFirstsRows}" HorizontalAlignment="Left" AutoGenerateColumns="False" CanUserAddRows="False"
                                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="260" Margin="0,0,0,16">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Guild" Binding="{Binding Guild, Mode=OneWay}" Width="Auto"/>
                                        <DataGridTextColumn Header="Firsts" Binding="{Binding Firsts, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap" Text="{Binding BenchmarkTitle}"/>
                                <DataGrid ItemsSource="{Binding BenchmarkRows}" HorizontalAlignment="Left" AutoGenerateColumns="False" CanUserAddRows="False"
                                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Class" Binding="{Binding Class, Mode=OneWay}" Width="Auto"/>
                                        <DataGridTextColumn Header="Fights" Binding="{Binding Fights, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Median DPS" Binding="{Binding MedianDps, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Top 10% DPS" Binding="{Binding TopDps, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Median HPS" Binding="{Binding MedianHps, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                        <DataGridTextColumn Header="Taken/sec" Binding="{Binding MedianTaken, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2" Visibility="{Binding ShowMobsView, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="420"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="2*" MinWidth="320"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0" ItemsSource="{Binding BossHistoryRows}" SelectedItem="{Binding SelectedBossHistoryRow, Mode=TwoWay}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mob" Binding="{Binding Boss, Mode=OneWay}" Width="Auto" MinWidth="160"/>
                                <DataGridTextColumn Header="Highest Level" Binding="{Binding HighestLevel, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Lowest Level" Binding="{Binding LowestLevel, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Kills" Binding="{Binding Kills, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Magic" Binding="{Binding Magic, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Fire" Binding="{Binding Fire, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Cold" Binding="{Binding Cold, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Poison" Binding="{Binding Poison, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Disease" Binding="{Binding Disease, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Shared by" Binding="{Binding SharedBy, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Attempts" Binding="{Binding Attempts, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Fastest kill" Binding="{Binding Fastest, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Average kill" Binding="{Binding Average, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Trend" Binding="{Binding Trend, Mode=OneWay}" Width="Auto">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="ToolTip" Value="The last kills' average time against the earlier kills (3 kills or more)."/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Server First" Binding="{Binding ServerFirst, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Server Best" Binding="{Binding ServerBest, Mode=OneWay}" Width="Auto">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="ToolTip" Value="The fastest kill and best raid DPS anyone has shared for this mob on this server."/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Regen" Binding="{Binding Regen, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="ToolTip" Value="Estimated hit points regained per second, from kills of different lengths (3 kills or more)."/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Est. HP" Binding="{Binding Hp, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Best DPS" Binding="{Binding BestDps, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Most players" Binding="{Binding Players, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Last fought" Binding="{Binding LastFought, Mode=OneWay}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- the kills of the selected boss -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                                <Button DockPanel.Dock="Right" Content="Copy Image for Discord" Command="{Binding CopyBossKillsImageCommand}"
                                        ToolTip="Copies a picture of every kill of this boss. Paste it into Discord."/>
                                <Button DockPanel.Dock="Right" Content="Copy list" Command="{Binding CopyBossKillsCommand}" Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0"/>
                                <TextBlock DockPanel.Dock="Left" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Text="{Binding BossKillsTitle}"/>
                            </DockPanel>
                            <DataGrid x:Name="BossKillGrid" Grid.Row="1" ItemsSource="{Binding BossKillRows}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Auto"
                                      ToolTip="Double-click a kill to open it on the Encounter DPS tab.">
                                <DataGrid.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenBossKillCommand}"
                                                  CommandParameter="{Binding SelectedItem, ElementName=BossKillGrid}"/>
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Number, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                    <DataGridTextColumn Header="Started" Binding="{Binding Started, Mode=OneWay}" Width="Auto"/>
                                    <DataGridTemplateColumn Header="Clear time" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ClearTime}" HorizontalAlignment="Right" Margin="6,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFastest}" Value="True">
                                                                    <Setter Property="Foreground" Value="#7EE0A1"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="DPS" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Dps}" HorizontalAlignment="Right" Margin="6,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBestDps}" Value="True">
                                                                    <Setter Property="Foreground" Value="#F5C46B"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Players" Binding="{Binding Players, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                    <DataGridTextColumn Header="Deaths" Binding="{Binding Deaths, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                    <DataGridTextColumn Header="Damage" Binding="{Binding Damage, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                    <DataGridTextColumn Header="Drops" Binding="{Binding Drops, Mode=OneWay}" Width="Auto" MaxWidth="420" ElementStyle="{StaticResource WrapCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                <TextBlock Margin="0,0,0,6" TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding BossAttemptsLine}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BossAttemptsLine}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Margin="0,0,0,6">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BossTrendLine}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,4" Text="{Binding BossTrendLine}"/>
                                    <ItemsControl ItemsSource="{Binding BossTrendBars}" Height="44" Focusable="False"
                                                  ToolTip="Clear time of each kill, oldest on the left. A shorter bar is a faster kill.">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="12" Margin="0,0,3,0" VerticalAlignment="Bottom" CornerRadius="2"
                                                        Height="{Binding Height}" ToolTip="{Binding Tip}" Background="{DynamicResource DpsFillBrush}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding BossKillsHint}"/>
                            </StackPanel>

                            <!-- the selected mob's resists by type, and who the raid figures came from -->
                            <Border Grid.Row="3" Margin="0,10,0,0" Padding="10" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" Background="{DynamicResource WindowBgBrush}">
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" Text="{Binding ResistPanelTitle}"/>
                                    <DataGrid ItemsSource="{Binding ResistTypeRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="170" Margin="0,0,0,8">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Resist type" Binding="{Binding Type, Mode=OneWay}" Width="*"/>
                                            <DataGridTextColumn Header="Landed" Binding="{Binding Landed, Mode=OneWay, StringFormat=N0}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                            <DataGridTextColumn Header="Resisted" Binding="{Binding Resisted, Mode=OneWay, StringFormat=N0}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                            <DataGridTextColumn Header="Resist %" Binding="{Binding Percent, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="Contributors"/>
                                    <DataGrid ItemsSource="{Binding ResistContributorRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="170" HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOutlier}" Value="True">
                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Player" Binding="{Binding Player, Mode=OneWay}" Width="Auto"/>
                                            <DataGridTextColumn Header="Shared" Binding="{Binding Shared, Mode=OneWay}" Width="Auto"/>
                                            <DataGridTextColumn Header="Magic" Binding="{Binding Magic, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                            <DataGridTextColumn Header="Fire" Binding="{Binding Fire, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                            <DataGridTextColumn Header="Cold" Binding="{Binding Cold, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                            <DataGridTextColumn Header="Poison" Binding="{Binding Poison, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                            <DataGridTextColumn Header="Disease" Binding="{Binding Disease, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="*" MinWidth="120"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding ResistPanelHint}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═════════ Experience ═════════ -->
            <TabItem Header="Experience">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="90"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*" MinHeight="140"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                        <Button DockPanel.Dock="Right" Content="Reset session" Style="{StaticResource SecondaryButton}" Command="{Binding ResetExperienceCommand}"
                                ToolTip="Starts counting again from now."/>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource HintText}" VerticalAlignment="Center" Text="{Binding ExperienceSession}"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1" HorizontalAlignment="Left" ItemsSource="{Binding ExperienceRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Character" Binding="{Binding Character, Mode=OneWay}" Width="Auto" MinWidth="120"/>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="XP this session" Binding="{Binding XpSession, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="XP / hour" Binding="{Binding XpPerHour, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Zone Median" Binding="{Binding ZoneMedian, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="ToolTip" Value="Everyone's median XP per hour in the zone the character is in, at its level band (from the Leveling tab)."/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Next level in" Binding="{Binding NextLevel, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="AAs gained" Binding="{Binding AaGained, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="AA / hour" Binding="{Binding AaPerHour, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Next AA in" Binding="{Binding NextAa, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Legacy bonus" Binding="{Binding LegacyBonus, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Kills with XP" Binding="{Binding Kills, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Last gain" Binding="{Binding LastGain, Mode=OneWay}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <UniformGrid Grid.Row="2" Rows="1" Margin="0,10,0,0">
                        <Border Margin="0,0,8,0" Padding="10,8" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderSoftBrush}" Background="{DynamicResource WindowBgBrush}">
                            <StackPanel><TextBlock Style="{StaticResource HintText}" Text="Session length"/><TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding ExperienceSessionLength}"/></StackPanel>
                        </Border>
                        <Border Margin="0,0,8,0" Padding="10,8" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderSoftBrush}" Background="{DynamicResource WindowBgBrush}">
                            <StackPanel><TextBlock Style="{StaticResource HintText}" Text="Party / raid / solo kills"/><TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding ExperienceKillSplit}"/></StackPanel>
                        </Border>
                        <Border Margin="0,0,8,0" Padding="10,8" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderSoftBrush}" Background="{DynamicResource WindowBgBrush}">
                            <StackPanel><TextBlock Style="{StaticResource HintText}" Text="Levels gained"/><TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding ExperienceLevelsGained}"/></StackPanel>
                        </Border>
                        <Border Padding="10,8" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderSoftBrush}" Background="{DynamicResource WindowBgBrush}">
                            <StackPanel><TextBlock Style="{StaticResource HintText}" Text="AA points gained"/><TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding ExperienceAaGained}"/></StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock Grid.Row="3" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding ExperienceHint}"/>

                    <!-- Experience by mob, per character level -->
                    <DockPanel Grid.Row="4" Margin="0,14,0,8" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Experience by mob" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Scan log history" Style="{StaticResource SecondaryButton}" Command="{Binding ScanMobExperienceCommand}"
                                ToolTip="Reads every watched log from the start again and rebuilds its table."/>
                        <ComboBox DockPanel.Dock="Right" Width="80" Margin="6,0,12,0" ItemsSource="{Binding MobExperienceLevels}"
                                  SelectedItem="{Binding SelectedMobExperienceLevel, Mode=TwoWay}"/>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource HintText}" VerticalAlignment="Center" Text="Level"/>
                        <ComboBox DockPanel.Dock="Right" Width="200" Margin="6,0,12,0" ItemsSource="{Binding MobExperienceCharacters}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedMobExperienceCharacter, Mode=TwoWay}"/>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource HintText}" VerticalAlignment="Center" Text="Character"/>
                    </DockPanel>
                    <DockPanel Grid.Row="5">
                    <DockPanel DockPanel.Dock="Right" Margin="16,0,0,0">
                        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6" Text="XP by zone (last 7 days)"/>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="420"
                                   Text="All your characters together; hours are time played in the zone. Best XP per hour first."/>
                        <DataGrid HorizontalAlignment="Left" ItemsSource="{Binding ZoneXpRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Zone" Binding="{Binding Zone, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="XP / hour" Binding="{Binding XpPerHour, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="XP" Binding="{Binding Xp, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Hours" Binding="{Binding Hours, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Kills with XP" Binding="{Binding Gains, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <DataGrid HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding MobExperienceRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Mob" Binding="{Binding Mob, Mode=OneWay}" Width="Auto" MinWidth="160"/>
                            <DataGridTextColumn Header="Kills" Binding="{Binding Kills, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Avg % per kill" Binding="{Binding AveragePercent, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Total %" Binding="{Binding TotalPercent, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Last kill" Binding="{Binding LastKill, Mode=OneWay}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    </DockPanel>
                    <TextBlock Grid.Row="6" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding MobExperienceStatus}"/>
                </Grid>
            </TabItem>

            <!-- ═════════ Session ═════════ -->
            <TabItem Header="Session">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <ComboBox Width="130" Margin="0,0,14,0" VerticalAlignment="Center" ItemsSource="{Binding SessionViews}" SelectedIndex="{Binding SessionViewIndex}"/>
                        <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding SessionStatus}"/>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <DataGrid ItemsSource="{Binding SessionRows}" SelectedItem="{Binding SelectedSessionRow, Mode=TwoWay}" HorizontalAlignment="Left"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Visibility="{Binding ShowSessionToday, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Character" Binding="{Binding Character, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Played" Binding="{Binding Played, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="XP" Binding="{Binding Xp, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Platinum" Binding="{Binding Platinum, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Plat/hour" Binding="{Binding PlatPerHour, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Kills" Binding="{Binding Kills, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Skill-ups" Binding="{Binding SkillUps, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid ItemsSource="{Binding SessionWeekRows}" SelectedItem="{Binding SelectedSessionRow, Mode=TwoWay}" HorizontalAlignment="Left"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" MaxHeight="420"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Visibility="{Binding SessionWeek, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Day" Binding="{Binding Day, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Character" Binding="{Binding Character, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Played" Binding="{Binding Played, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="XP" Binding="{Binding Xp, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Platinum" Binding="{Binding Platinum, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Plat/hour" Binding="{Binding PlatPerHour, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Kills" Binding="{Binding Kills, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Skill-ups" Binding="{Binding SkillUps, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <TextBlock Grid.Row="2" FontWeight="SemiBold" Margin="0,14,0,6" Text="Zone timeline (select a character above)"/>
                    <ctl:ZoneTimelineControl Grid.Row="3" Stretches="{Binding SelectedZoneStretches}" Margin="0,0,0,8"/>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Top">
                    <DataGrid ItemsSource="{Binding ZoneRows}" HorizontalAlignment="Left" VerticalAlignment="Top"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Zone" Binding="{Binding Zone, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="From" Binding="{Binding From, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="To" Binding="{Binding To, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding Length, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Margin="24,0,0,0" VerticalAlignment="Top">
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" Text="Plat by zone (last 7 days)"/>
                        <DataGrid ItemsSource="{Binding ZonePlatRows}" HorizontalAlignment="Left" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="360">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Zone" Binding="{Binding Zone, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Platinum" Binding="{Binding Platinum, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Plat/hour" Binding="{Binding PerHour, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Hours" Binding="{Binding Hours, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="360"
                                   Text="All your characters together: coin looted and split, by the zone you were in."/>
                    </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ═════════ Leveling ═════════ -->
            <TabItem Header="Leveling">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Server" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="140" ItemsSource="{Binding LevelingServers}" SelectedItem="{Binding SelectedLevelingServer}" Margin="0,0,16,0"/>
                            <TextBlock Text="Level" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Width="50" VerticalAlignment="Center" Text="{Binding LevelingLevel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0"/>
                            <RadioButton Content="Solo" VerticalAlignment="Center" Margin="0,0,10,0" GroupName="LevelingKind"
                                         IsChecked="{Binding LevelingSolo}"/>
                            <RadioButton Content="Group" VerticalAlignment="Center" Margin="0,0,10,0" GroupName="LevelingKind" IsChecked="{Binding LevelingGroupChoice}"/>
                            <RadioButton Content="AA" VerticalAlignment="Center" GroupName="LevelingKind" IsChecked="{Binding LevelingAa}"
                                         ToolTip="Ranks zones by AA points per hour, solo and group together. Picked on its own at the server's highest level seen."/>
                        </StackPanel>

                        <TextBlock FontWeight="SemiBold" Text="Expansions on this server" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding LevelingExpansionChoices}" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel MaxWidth="900"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsOn}" Margin="0,2,14,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                            <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Text="{Binding LevelingExpansionHint}"/>
                            <Button Content="Use zones seen" Command="{Binding UseZonesSeenForExpansionsCommand}" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>

                        <TextBlock Margin="0,0,0,6" Foreground="#6FDC8C" Text="{Binding LevelingEtaText}"/>
                        <TextBlock Margin="0,0,0,6" Foreground="#E8C66A" FontWeight="SemiBold" Text="{Binding BonusXpText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,6">
                            <Run Text="Best zones for levels"/>
                            <Run Text="{Binding LevelingBandText, Mode=OneWay}"/>
                        </TextBlock>
                        <DataGrid ItemsSource="{Binding LevelingZoneRows}" SelectedItem="{Binding SelectedLevelingZone, Mode=TwoWay}" HorizontalAlignment="Left"
                                  AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Zone" Binding="{Binding Zone, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Expansion" Binding="{Binding Expansion, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="XP/hour" Binding="{Binding XpPerHour, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Kills/hour" Binding="{Binding KillsPerHour, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Plat/hour" Binding="{Binding PlatPerHour, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Mob Levels" Binding="{Binding MobLevels, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Players" Binding="{Binding Players, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Hours" Binding="{Binding Hours, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Data" Binding="{Binding Data, Mode=OneWay}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock FontWeight="SemiBold" Margin="0,6,0,6" Text="{Binding LevelingBestMobsTitle}"/>
                        <DataGrid ItemsSource="{Binding LevelingBestMobs}" HorizontalAlignment="Left" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="0,0,0,14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mob" Binding="{Binding Mob, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Levels" Binding="{Binding Levels, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="XP/kill" Binding="{Binding XpPerKill, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                                <DataGridTextColumn Header="Your Kills" Binding="{Binding Kills, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" Text="Leveling path"/>
                        <DataGrid ItemsSource="{Binding LevelingPathRows}" HorizontalAlignment="Left" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="420" Margin="0,0,0,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Levels" Binding="{Binding Levels, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="Best Zone" Binding="{Binding Zone, Mode=OneWay}" Width="Auto"/>
                                <DataGridTextColumn Header="XP/hour" Binding="{Binding XpPerHour, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" Text="{Binding LevelingStatus}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═════════ Spell Stats ═════════ -->
            <TabItem Header="Spell Stats">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <ComboBox Width="180" Margin="0,0,12,0" ItemsSource="{Binding SpellStatCharacters}" SelectedItem="{Binding SpellStatCharacter}"/>
                        <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Text="Today since midnight, from your characters' logs."/>
                    </WrapPanel>
                    <TextBlock Grid.Row="1" FontWeight="SemiBold" Margin="0,0,0,6" Text="Casts"/>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding SpellStatRows}" HorizontalAlignment="Left" VerticalAlignment="Top"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Character" Binding="{Binding Character, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Spell" Binding="{Binding Spell, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Casts" Binding="{Binding Casts, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Fizzles" Binding="{Binding Fizzles, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Fizzle %" Binding="{Binding FizzlePercent, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Interrupts" Binding="{Binding Interrupts, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Interrupt %" Binding="{Binding InterruptPercent, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Didn't take hold" Binding="{Binding Blocked, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Blocked by" Binding="{Binding BlockedBy, Mode=OneWay}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="3" FontWeight="SemiBold" Margin="0,12,0,6" Text="Resists"/>
                    <DataGrid Grid.Row="4" ItemsSource="{Binding ResistStatRows}" HorizontalAlignment="Left" VerticalAlignment="Top"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Character" Binding="{Binding Character, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Spell" Binding="{Binding Spell, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Mob" Binding="{Binding Mob, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Landed" Binding="{Binding Landed, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Resisted" Binding="{Binding Resisted, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                            <DataGridTextColumn Header="Resist %" Binding="{Binding ResistPercent, Mode=OneWay}" Width="Auto" ElementStyle="{StaticResource NumericCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ═════════ Maps ═════════ -->
            <TabItem Header="Maps">
                <Grid Margin="6" DataContext="{Binding Maps}">
                    <Grid.Resources>
                        <BooleanToVisibilityConverter x:Key="MapsVisible"/>
                        <Style x:Key="MapsSubTab" TargetType="RadioButton">
                            <Setter Property="Margin" Value="0,0,6,0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Box" Padding="12,5" CornerRadius="6" BorderThickness="1"
                                                BorderBrush="{DynamicResource BorderSoftBrush}" Background="Transparent">
                                            <ContentPresenter x:Name="Text" TextElement.Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Text" Property="TextElement.Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="MapsShowOnSelect" TargetType="FrameworkElement">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelectZoneTab}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="MapsShowOnCurrent" TargetType="FrameworkElement">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrentZoneTab}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton GroupName="MapsSubTabs" Style="{StaticResource MapsSubTab}" Content="Current Zone" IsChecked="{Binding IsCurrentZoneTab, Mode=TwoWay}"/>
                        <RadioButton GroupName="MapsSubTabs" Style="{StaticResource MapsSubTab}" Content="Select Zone" IsChecked="{Binding IsSelectZoneTab, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- Expansion, Zone and Map pack in one row (Current zone shows where the character you played last is instead of the first two) -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource MapsShowOnSelect}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabel}" Text="Expansion"/>
                            <ComboBox ItemsSource="{Binding Expansions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedExpansion, Mode=TwoWay}"/>
                        </DockPanel>
                        <DockPanel Grid.Column="1" Margin="0,0,12,0" Style="{StaticResource MapsShowOnSelect}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabel}" Text="Zone"/>
                            <ComboBox ItemsSource="{Binding ZoneChoices}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedZone, Mode=TwoWay}"/>
                        </DockPanel>
                        <DockPanel Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,12,0" Style="{StaticResource MapsShowOnCurrent}">
                            <ComboBox DockPanel.Dock="Right" MinWidth="220" Margin="8,0,0,0" ItemsSource="{Binding CurrentChoices}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedCurrentChoice, Mode=TwoWay}"
                                      Visibility="{Binding HasCurrentChoices, Converter={StaticResource MapsVisible}}"
                                      ToolTip="This zone name has more than one map. Pick the one you are in."/>
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding CurrentZoneText}"/>
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabel}" Text="Map pack"/>
                            <ComboBox ItemsSource="{Binding Packs}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedPack, Mode=TwoWay}"
                                      ToolTip="The map folder under maps in your EverQuest folder. Labels are saved to this pack only."/>
                        </DockPanel>
                        <Button Grid.Column="3" Margin="10,0,0,0" Content="Reload" Style="{StaticResource SecondaryButton}" Command="{Binding ReloadCommand}"
                                ToolTip="Reads the map packs and map files again, for changes made outside the app."/>
                    </Grid>

                    <DockPanel Grid.Row="2" Margin="0,0,0,8" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabel}" Text="Edit layer"/>
                        <ListBox DockPanel.Dock="Left" ItemsSource="{Binding LayerChoices}" SelectedIndex="{Binding SelectedLayer, Mode=TwoWay}"
                                 BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ToolTip="Base is zone.txt; 1 to 3 are zone_1.txt to zone_3.txt. The other layers show dimmed.">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" MinWidth="34" TextAlignment="Center" Padding="2,1"/></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="10,0,0,0" Text="{Binding LayerFileText}"/>
                        <TextBlock Style="{StaticResource ErrorText}" VerticalAlignment="Center" Margin="16,0,0,0" Text="{Binding FollowNote}"/>
                    </DockPanel>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}" Margin="0,4,0,0"
                                       Text="Drag this layer's labels to move them, or click empty map to place a new one. Wheel zooms, right-drag moves the map, right double-click fits it. Gray is the other layers; the yellow ring is your last /loc."/>
                            <Border CornerRadius="6" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource BorderSoftBrush}">
                                <ctl:MapCanvas Maps="{Binding}"/>
                            </Border>
                        </DockPanel>

                        <DockPanel Grid.Column="1">
                            <StackPanel DockPanel.Dock="Bottom">
                                <TextBlock FontWeight="SemiBold" Margin="0,10,0,4" Text="{Binding FormTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Text"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="/loc"/>
                                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Use my /loc" Style="{StaticResource SecondaryButton}" Command="{Binding UseMyLocCommand}"
                                                ToolTip="The last /loc in this zone of the character you played last."/>
                                        <TextBox Text="{Binding EditLoc, UpdateSourceTrigger=PropertyChanged}" ToolTip="Y, X, Z as /loc prints them."/>
                                    </DockPanel>
                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Color"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                        <ctl:ColorSwatchPicker Width="24" Height="24" Hex="{Binding EditColorHex, Mode=TwoWay}"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="16,0,10,0" Text="Size"/>
                                        <ComboBox Width="100" ItemsSource="{Binding SizeChoices}" DisplayMemberPath="Label" SelectedItem="{Binding EditSize, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource ErrorText}" Margin="0,6,0,0" Text="{Binding ErrorText}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Add label" Margin="0,0,6,0" Command="{Binding AddLabelCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="New label" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" Command="{Binding NewLabelCommand}"
                                            Visibility="{Binding IsEditing, Converter={StaticResource MapsVisible}}"/>
                                    <Button Content="Save layer" Margin="0,0,6,0" Command="{Binding SaveCommand}"/>
                                    <Button Content="Discard changes" Style="{StaticResource SecondaryButton}" Command="{Binding DiscardChangesCommand}"
                                            Visibility="{Binding IsDirty, Converter={StaticResource MapsVisible}}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" Text="{Binding StatusLine}"/>
                            </StackPanel>

                            <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,4" Text="{Binding LabelListTitle}"/>
                            <ListBox ItemsSource="{Binding Labels}" SelectedItem="{Binding SelectedLabel, Mode=TwoWay}" HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}"
                                                    ToolTip="Delete this label"
                                                    Command="{Binding DataContext.DeleteLabelCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource HintText}" VerticalAlignment="Center" Text="{Binding LocText}"/>
                                            <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="2" Margin="0,0,8,0" Background="{Binding Hex}"/>
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Text}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═════════ Log search ═════════ -->
            <TabItem Header="Log Search">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding CancelLogSearchCommand}"/>
                        <Button DockPanel.Dock="Right" Content="Search" Margin="8,0,0,0" Command="{Binding SearchLogsCommand}"/>
                        <ComboBox DockPanel.Dock="Right" Width="130" Margin="8,0,0,0" ItemsSource="{Binding LogSearchRanges}" SelectedIndex="{Binding LogSearchRangeIndex}"/>
                        <ComboBox DockPanel.Dock="Right" Width="160" Margin="8,0,0,0" ItemsSource="{Binding LogSearchCharacters}" SelectedItem="{Binding LogSearchCharacter}"
                                  DropDownOpened="LogSearchCharacters_DropDownOpened"/>
                        <TextBox VerticalAlignment="Center" Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="LogSearchText_KeyDown"
                                 ToolTip="Every word must be in the line (capitals ignored). Put a phrase in quotes to keep it together."/>
                    </DockPanel>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding LogSearchChannels}" Margin="0,0,0,8" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" Margin="0,0,16,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ProgressBar Grid.Row="2" Height="4" Margin="0,0,0,6" Maximum="100" Value="{Binding LogSearchProgress}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Hidden"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLogSearching}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <DataGrid Grid.Row="3" ItemsSource="{Binding LogSearchRows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single" MouseDoubleClick="LogSearchGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Character" Binding="{Binding Character, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Channel" Binding="{Binding Channel, Mode=OneWay}" Width="Auto"/>
                            <DataGridTextColumn Header="Line" Binding="{Binding Line, Mode=OneWay}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="4" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding LogSearchStatus}"/>
                </Grid>
            </TabItem>

            <!-- ═════════ Players & Pets ═════════ -->
            <!-- ═════════ Chat ═════════ -->
