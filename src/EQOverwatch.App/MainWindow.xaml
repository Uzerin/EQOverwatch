                    <TextBox Width="260" Text="{Binding ChatSearch, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             ToolTip="Finds lines in every chat channel whose message or speaker contains this text"/>
                    <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="12,0,0,0" Text="{Binding ChatSearchStatus}"/>
                </DockPanel>
                <TabControl Margin="6" SelectedIndex="{Binding SelectedChatTab, Mode=TwoWay}">
