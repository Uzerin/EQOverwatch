<Window x:Class="EQOverwatch.App.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search everything"
        Icon="pack://application:,,,/Assets/EQOverwatch.ico"
        Width="620" Height="520" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="14,4,14,14">
        <TextBox x:Name="Query" DockPanel.Dock="Top" FontSize="15" Padding="8,6" Margin="0,0,0,6" TextChanged="Query_TextChanged" PreviewKeyDown="Query_PreviewKeyDown"
                 ToolTip="Part of a character, item, mob or trigger name. Enter opens the highlighted result; Esc closes."/>
        <TextBlock x:Name="Status" DockPanel.Dock="Top" Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,6"
                   Text="Type at least two letters: characters, items, mobs and fights, triggers, spells, zones."/>
        <ListBox x:Name="Results" MouseDoubleClick="Results_MouseDoubleClick" KeyDown="Results_KeyDown">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="2,8,0,2"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,0,0" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
