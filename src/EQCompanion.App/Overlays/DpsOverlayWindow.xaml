<overlays:OverlayWindowBase x:Class="EQCompanion.App.Overlays.DpsOverlayWindow"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:overlays="clr-namespace:EQCompanion.App.Overlays"
                            xmlns:vm="clr-namespace:EQCompanion.App.ViewModels"
                            Title="EQ Overwatch DPS"
                            OverlayName="DPS"
                            WindowStartupLocation="Manual"
                            Left="450" Top="100"
                            Width="300" Height="230"
                            MinWidth="240" MinHeight="90">
    <Grid>
        <Border Style="{StaticResource OverlayBackdropStyle}"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource OverlayTitleStripStyle}"
                    MouseLeftButtonDown="OnTitleStripMouseDown">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Img" Style="{StaticResource OverlayChipButtonStyle}"
                            ToolTip="Copy this fight as a picture for Discord"
                            Command="{Binding CopyImageCommand}"/>
                    <Button DockPanel.Dock="Right" Content="Chat" Style="{StaticResource OverlayChipButtonStyle}"
                            ToolTip="Copy the top 12 attackers for EverQuest chat"
                            Command="{Binding CopyChatCommand}"/>
                    <TextBlock Margin="6,0"
                               Style="{StaticResource OverlayTextStyle}"
                               Text="{Binding OverlayName, RelativeSource={RelativeSource AncestorType={x:Type overlays:OverlayWindowBase}}}"/>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="4" ClipToBounds="True">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <!-- An encounter that has ended is shown dimmed. -->
                            <DataTrigger Binding="{Binding IsLive}" Value="False">
                                <Setter Property="Opacity" Value="0.65"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Header: target, encounter length, group DPS -->
                <Border Padding="6,3" CornerRadius="3" Background="{DynamicResource RowBackdropBrush}">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource OverlayTextStyle}"/>
                            <TextBlock Text="{Binding GroupDpsText}" Margin="10,0,0,0" Foreground="{DynamicResource AlertTextBrush}" Style="{StaticResource OverlayTextStyle}"/>
                            <TextBlock Text=" DPS" Style="{StaticResource OverlayMutedTextStyle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TargetName}" TextTrimming="CharacterEllipsis" Style="{StaticResource OverlayTextStyle}"/>
                    </DockPanel>
                </Border>

                <!-- Column captions -->
                <Grid Margin="6,3,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="SDPS" HorizontalAlignment="Right" Style="{StaticResource OverlayMutedTextStyle}"/>
                    <TextBlock Grid.Column="2" Text="Total" HorizontalAlignment="Right" Style="{StaticResource OverlayMutedTextStyle}"/>
                    <TextBlock Grid.Column="3" Text="%" HorizontalAlignment="Right" Style="{StaticResource OverlayMutedTextStyle}"/>
                </Grid>

                <!-- Ranked rows with relative fill bars -->
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DpsRowViewModel}">
                            <Grid Height="20" Margin="0,1">
                                <Border Background="{DynamicResource BarBackBrush}" CornerRadius="3"/>
                                <Border Background="{DynamicResource DpsFillBrush}"
                                        CornerRadius="3"
                                        RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding Fill}"/>
                                    </Border.RenderTransform>
                                </Border>
                                <Grid Margin="6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding RankName}" TextTrimming="CharacterEllipsis" Style="{StaticResource OverlayTextStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SdpsText}" HorizontalAlignment="Right" Style="{StaticResource OverlayTextStyle}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TotalText}" HorizontalAlignment="Right" Style="{StaticResource OverlayTextStyle}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding PercentText}" HorizontalAlignment="Right" Style="{StaticResource OverlayTextStyle}"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <Rectangle Style="{StaticResource OverlayDashedBorderStyle}"/>
    </Grid>
</overlays:OverlayWindowBase>
